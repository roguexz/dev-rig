# Default ignored files
.idea/
*.log
.DS_Store
__pycache__/
.playwright-cli/

# Compiled Touch ID helper (normally built into $HOME/.local/bin by 'ldx touchid install')
touchid_auth

# OpenChamber
.agents/
skills-lock.json

# Helm dependency artifacts (regenerated by 'helm dependency build'; the
# Chart.lock files next to Chart.yaml are the pinned source of truth)
charts/*/charts/
