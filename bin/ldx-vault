#!/usr/bin/env bash

set -euo pipefail

get_script_dir() {
  local SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SOURCE" ]; do
    local DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
  done
  cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR="$(get_script_dir)"
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    echo "Usage: $(basename "$0") <setup|status|unseal|seal|uninstall> [options]"
    echo ""
    echo "Commands:"
    echo "  setup      Install Vault, initialize it, and store keys."
    echo "  status     Show the current status of the Vault installation."
    echo "  unseal     Unseal the Vault using stored keys."
    echo "  seal       Seal the Vault."
    echo "  uninstall  Remove Vault and its stored keys."
    echo ""
    echo "Options for setup:"
    echo "  --oidc-client-id <id>          Google OIDC Client ID (enables OIDC login with WebAuthn/Passkeys)"
    echo "  --oidc-client-secret <secret>  Google OIDC Client Secret"
    echo "  --disable-userpass             Disable the default 'admin' userpass login (useful if relying purely on OIDC)"
    echo ""
    echo "Alternatively, you can set OIDC_CLIENT_ID and OIDC_CLIENT_SECRET environment variables."
}

status_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"

    # Check if pod exists
    local phase
    phase=$(kubectl get pods vault-0 -n "$namespace" -o 'jsonpath={..status.phase}' 2>/dev/null) || true

    if [ -z "$phase" ]; then
        log_info "Vault is not installed. Run 'setup' to install it."
        return
    fi

    if [ "$phase" != "Running" ]; then
        log_warn "Vault pod is in '$phase' state (not Running)."
        return
    fi

    # Pod is running, check sealed status
    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true

    if [ "$sealed" = "true" ]; then
        log_warn "Vault is running but sealed. Run 'unseal' to unseal it."
    elif [ "$sealed" = "false" ]; then
        log_info "Vault is running and unsealed."
    else
        log_warn "Vault pod is Running but could not determine seal status."
    fi

    log_info "Access URL: https://vault.rogue.io"
    log_info "In-cluster URL: http://vault.commons.svc.cluster.local:8200"
}

setup_vault() {
    require_command "helm"
    require_command "kubectl"

    log_info "Adding HashiCorp Helm repository..."
    helm repo add hashicorp https://helm.releases.hashicorp.com --force-update
    helm repo update hashicorp

    local namespace="commons"
    kubectl create namespace "$namespace" --dry-run=client -o yaml | kubectl apply -f -

    log_info "Installing Vault..."
    helm upgrade --install vault hashicorp/vault \
        --namespace "$namespace" \
        --set "server.dev.enabled=false" \
        --set "server.ha.enabled=false" \
        --set "server.standalone.enabled=true" \
        --set "server.dataStorage.size=1Gi" \
        --set "server.ingress.enabled=true" \
        --set "server.ingress.ingressClassName=traefik" \
        --set "server.ingress.hosts[0].host=vault.rogue.io" \
        --set "server.ingress.hosts[0].paths[0]=/" \
        --set "server.ingress.tls[0].secretName=default-tls-secret" \
        --set "server.ingress.tls[0].hosts[0]=vault.rogue.io" \
        --wait

    log_info "Waiting for Vault pod to be created and running..."
    while [[ $(kubectl get pods vault-0 -n "$namespace" -o 'jsonpath={..status.phase}' 2>/dev/null) != "Running" ]]; do
        echo -n "."
        sleep 2
    done
    echo ""

    sleep 5

    log_info "Initializing Vault..."
    if [ -f "${VAULT_DIR}/keys.json" ]; then
        log_warn "Vault keys already exist at ${VAULT_DIR}/keys.json. Skipping initialization."
        log_info "If you need to re-initialize, please remove the file and run setup again."
    else
        init_dirs
        kubectl exec -n "$namespace" vault-0 -- vault operator init -format=json > "${VAULT_DIR}/keys.json"
        log_info "Vault initialized. Unseal keys and root token saved to ${VAULT_DIR}/keys.json"
    fi

    unseal_vault

    configure_default_user

    log_info "Vault UI and API are accessible at: https://vault.rogue.io"
    if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
        log_info "You can login with Username: admin, Password: changeit"
    fi
    if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
        log_info "OIDC authentication is enabled. You can log in via your Identity Provider (e.g. Google)."
    fi
}

unseal_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"

    if [ ! -f "${VAULT_DIR}/keys.json" ]; then
        fatal "Vault keys not found at ${VAULT_DIR}/keys.json. Run 'setup' first."
    fi

    log_info "Unsealing Vault..."

    jq -r .unseal_keys_b64[] "${VAULT_DIR}/keys.json" | while read -r key; do
        kubectl exec -n "$namespace" vault-0 -- vault operator unseal "$key"
    done

    log_info "Vault unseal process complete."
}

configure_default_user() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"
    log_info "Configuring admin user and authentication methods..."

    if [ ! -f "${VAULT_DIR}/keys.json" ]; then
        log_warn "Root token not found. Skipping user configuration."
        return
    fi

    local root_token
    root_token=$(jq -r .root_token "${VAULT_DIR}/keys.json")

    # We use a temporary shell script executed inside the pod to keep things clean
    cat <<EOF | kubectl exec -i -n "$namespace" vault-0 -- sh
        export VAULT_TOKEN="${root_token}"

        # Create an admin policy that has full permissions
        vault policy write admin - <<POLICY
path "*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
POLICY

        # Always configure userpass unless DISABLE_USERPASS is true
        if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
            if ! vault auth list | grep -q "userpass/"; then
                vault auth enable userpass
            fi
            # Create or update the admin user with the password 'changeit' and assign the admin policy
            vault write auth/userpass/users/admin password=changeit policies=admin
        else
            # If someone explicitly disables it later, we could optionally disable the auth path,
            # but for a dev script, it's safer to just skip creating/updating it.
            if vault auth list | grep -q "userpass/"; then
                vault auth disable userpass || true
            fi
        fi

        # Configure OIDC if credentials are provided
        if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
            if ! vault auth list | grep -q "oidc/"; then
                vault auth enable oidc
            fi

            vault write auth/oidc/config \\
                oidc_discovery_url="https://accounts.google.com" \\
                oidc_client_id="${OIDC_CLIENT_ID:-}" \\
                oidc_client_secret="${OIDC_CLIENT_SECRET:-}" \\
                default_role="admin"

            vault write auth/oidc/role/admin \\
                bound_audiences="${OIDC_CLIENT_ID:-}" \\
                allowed_redirect_uris="https://vault.rogue.io/ui/vault/auth/oidc/oidc/callback" \\
                allowed_redirect_uris="http://localhost:8250/oidc/callback" \\
                user_claim="sub" \\
                policies="admin"
        fi
EOF

    local auth_methods=""
    if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
        auth_methods="Username/Password"
    fi
    if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
        if [ -n "$auth_methods" ]; then
            auth_methods="$auth_methods and OIDC"
        else
            auth_methods="OIDC"
        fi
    fi

    log_info "Vault configured successfully with ${auth_methods:-No} authentication."
}

seal_vault() {
    require_command "kubectl"

    local namespace="commons"
    log_info "Sealing Vault..."
    kubectl exec -n "$namespace" vault-0 -- vault operator seal
    log_info "Vault is now sealed."
}

uninstall_vault() {
    require_command "helm"
    require_command "kubectl"

    local namespace="commons"

    log_info "Uninstalling Vault Helm release..."
    helm uninstall vault -n "$namespace" || true

    log_info "Removing MutatingWebhookConfiguration..."
    kubectl delete mutatingwebhookconfiguration vault-agent-injector-cfg --ignore-not-found

    log_info "Removing Vault PVC to ensure clean re-install..."
    kubectl delete pvc -n "$namespace" data-vault-0 --ignore-not-found

    log_info "Removing local Vault keys..."
    rm -rf "${VAULT_DIR}"

    log_info "Vault uninstall complete. The 'commons' namespace was not deleted."
}

main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        setup)
            export DISABLE_USERPASS=false
            # Parse additional arguments for setup
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --oidc-client-id)
                        export OIDC_CLIENT_ID="$2"
                        shift 2
                        ;;
                    --oidc-client-secret)
                        export OIDC_CLIENT_SECRET="$2"
                        shift 2
                        ;;
                    --disable-userpass)
                        export DISABLE_USERPASS=true
                        shift 1
                        ;;
                    *)
                        log_error "Unknown option: $1"
                        show_help
                        exit 1
                        ;;
                esac
            done
            setup_vault
            ;;
        status)
            status_vault
            ;;
        unseal)
            unseal_vault
            ;;
        seal)
            seal_vault
            ;;
        uninstall)
            uninstall_vault
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            show_help
            exit 1
            ;;
    esac
}

main "$@"