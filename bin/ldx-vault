#!/usr/bin/env bash

set -euo pipefail

get_script_dir() {
  local SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SOURCE" ]; do
    local DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
  done
  cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR="$(get_script_dir)"

# Base version guard: the chart pins the Vault app version
# (0.34.1 -> Vault 2.0.4). Never silently pull a newer chart; ldx vault
# upgrade handles version moves deliberately (snapshot + checks).
VAULT_CHART_VERSION="0.34.1"

# The --set flags that define this rig's Vault deployment. Shared by setup and
# upgrade so an upgrade never relies on --reuse-values: chart 0.34.x added new
# value sections (server.httproute) whose templates blow up when the old
# release's values are reused without the new chart's defaults.
VAULT_HELM_SET_ARGS=(
    --set "server.dev.enabled=false"
    --set "server.ha.enabled=false"
    --set "server.standalone.enabled=true"
    --set "server.dataStorage.size=1Gi"
    --set "server.ingress.enabled=true"
    --set "server.ingress.ingressClassName=traefik"
    --set "server.ingress.hosts[0].host=vault.rogue.io"
    --set "server.ingress.hosts[0].paths[0]=/"
    --set "server.ingress.tls[0].secretName=default-tls-secret"
    --set "server.ingress.tls[0].hosts[0]=vault.rogue.io"
    # Chart 0.34.x hard-codes *required* pod anti-affinity on hostname for the agent
    # injector (its own comment says to clear it for single-node clusters). On Rancher
    # Desktop a rolling update can then never place its surge pod: the running pod
    # rejects the new one too, so `helm upgrade --wait` dies with
    # "Progress deadline exceeded". Surge 0 / unavailable 1 makes the old pod leave
    # before the new one schedules, which is what a single node needs. (type: Recreate
    # would do the same, but server-side apply then refuses the leftover
    # spec.strategy.rollingUpdate.)
    --set "injector.affinity="
    --set "injector.strategy.rollingUpdate.maxSurge=0"
    --set "injector.strategy.rollingUpdate.maxUnavailable=1"
)
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    echo "Usage: $(basename "$0") <setup|status|unseal|seal|create-user|upgrade|snapshot|uninstall> [options]"
    echo ""
    echo "Commands:"
    echo "  setup       Install Vault, initialize it, and store keys."
    echo "  status      Show the current status of the Vault installation."
    echo "  unseal      Unseal the Vault using stored keys."
    echo "  seal        Seal the Vault."
    echo "  create-user Create (or update) a userpass user with entity metadata."
    echo "  upgrade     Upgrade Vault to a chart version (default: latest) with a snapshot + checks."
    echo "  snapshot    Save a storage snapshot (Raft or file backend; Vault must be unsealed)."
    echo "  uninstall   Remove Vault and its stored keys."
    echo ""
    echo "Options for setup:"
    echo "  --oidc-client-id <id>          Google OIDC Client ID (enables OIDC login with WebAuthn/Passkeys)"
    echo "  --oidc-client-secret <secret>  Google OIDC Client Secret"
    echo "  --disable-userpass             Disable the default 'admin' userpass login (useful if relying purely on OIDC)"
    echo ""
    echo "Options for create-user:"
    echo "  --password <pass>      Password (prompted when omitted)"
    echo "  --full-name <name>     Display name exposed to OIDC clients via the profile scope"
    echo "  --email <email>        Email exposed to OIDC clients via the profile scope"
    echo "  --policies <list>      Vault policies for the user (default: default)"
    echo ""
    echo "Options for upgrade:"
    echo "  <chart-version>        Target chart version (e.g. 0.34.1, app Vault 2.0.4)."
    echo "                         Omit to upgrade to the latest chart."
    echo "  --dry-run              Show what would change; do not touch the cluster."
    echo ""
    echo "Alternatively, you can set OIDC_CLIENT_ID and OIDC_CLIENT_SECRET environment variables."
}

status_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"

    # Check if pod exists
    local phase
    phase=$(kubectl get pods vault-0 -n "$namespace" -o 'jsonpath={..status.phase}' 2>/dev/null) || true

    if [ -z "$phase" ]; then
        log_info "Vault is not installed. Run 'setup' to install it."
        return
    fi

    if [ "$phase" != "Running" ]; then
        log_warn "Vault pod is in '$phase' state (not Running)."
        return
    fi

    # Pod is running, check sealed status
    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true

    if [ "$sealed" = "true" ]; then
        log_warn "Vault is running but sealed. Run 'unseal' to unseal it."
    elif [ "$sealed" = "false" ]; then
        log_info "Vault is running and unsealed."
    else
        log_warn "Vault pod is Running but could not determine seal status."
    fi

    log_info "Access URL: https://vault.rogue.io"
    log_info "In-cluster URL: http://vault.commons.svc.cluster.local:8200"
}

# helm --wait names only the resource it gave up on. Say which pods are stuck and
# quote what the scheduler complained about, so a failed rollout needs no follow-up
# kubectl to understand. Informational: exit status stays with the caller.
report_unready_pods() {
    local namespace="$1"

    kubectl get pods -n "$namespace" --no-headers 2>/dev/null |
        awk '{split($2, r, "/"); if (r[1] + 0 < r[2] + 0) printf "  %s  %s (%s)\n", $1, $3, $2}' |
        { grep . || echo "  (nothing reports not-ready; check 'helm history' for a stale failure)"; }

    kubectl get events -n "$namespace" --sort-by=.lastTimestamp 2>/dev/null |
        awk '$1 == "Warning"' | tail -n 5 | sed 's/^/  /'
}

setup_vault() {
    require_command "helm"
    require_command "kubectl"

    log_info "Adding HashiCorp Helm repository..."
    helm repo add hashicorp https://helm.releases.hashicorp.com --force-update
    helm repo update hashicorp

    local namespace="commons"
    kubectl create namespace "$namespace" --dry-run=client -o yaml | kubectl apply -f -

    # Cache the version before installing so it survives even if init is interrupted.
    record_vault_version "$VAULT_CHART_VERSION" "$(vault_app_version_for_chart "$VAULT_CHART_VERSION")"

    log_info "Installing Vault via Helm (chart ${VAULT_CHART_VERSION})..."
    if ! helm upgrade --install vault hashicorp/vault \
        --version "$VAULT_CHART_VERSION" \
        --namespace "$namespace" \
        "${VAULT_HELM_SET_ARGS[@]}" \
        --force-conflicts \
        --wait; then
        log_error "Vault install/upgrade did not finish. Pods that are not ready:"
        report_unready_pods "$namespace"
        fatal "Release 'vault' in namespace '${namespace}' may be half-applied. Fix the pods above and re-run 'setup'; it is idempotent."
    fi

    log_info "Waiting for Vault pod to be created and running..."
    while [[ $(kubectl get pods vault-0 -n "$namespace" -o 'jsonpath={..status.phase}' 2>/dev/null) != "Running" ]]; do
        echo -n "."
        sleep 2
    done
    echo ""

    sleep 5

    log_info "Initializing Vault..."
    if [ -f "${VAULT_DIR}/keys.json" ]; then
        log_warn "Vault keys already exist at ${VAULT_DIR}/keys.json. Skipping initialization."
        log_info "If you need to re-initialize, please remove the file and run setup again."
    else
        init_dirs
        kubectl exec -n "$namespace" vault-0 -- vault operator init -format=json > "${VAULT_DIR}/keys.json"
        log_info "Vault initialized. Unseal keys and root token saved to ${VAULT_DIR}/keys.json"
    fi

    unseal_vault

    configure_default_user

    log_info "Vault UI and API are accessible at: https://vault.rogue.io"
    if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
        log_info "You can login with Username: admin, Password: changeit"
    fi
    if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
        log_info "OIDC authentication is enabled. You can log in via your Identity Provider (e.g. Google)."
    fi
}

unseal_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"

    if [ ! -f "${VAULT_DIR}/keys.json" ]; then
        fatal "Vault keys not found at ${VAULT_DIR}/keys.json. Run 'setup' first."
    fi

    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true
    if [ "$sealed" = "false" ]; then
        log_info "Vault is already unsealed."
        return
    fi

    log_info "Unsealing Vault..."

    jq -r .unseal_keys_b64[] "${VAULT_DIR}/keys.json" | while read -r key; do
        kubectl exec -n "$namespace" vault-0 -- vault operator unseal "$key"
    done

    log_info "Vault unseal process complete."
}

configure_default_user() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"
    log_info "Configuring admin user and authentication methods..."

    if [ ! -f "${VAULT_DIR}/keys.json" ]; then
        log_warn "Root token not found. Skipping user configuration."
        return
    fi

    local root_token
    root_token=$(jq -r .root_token "${VAULT_DIR}/keys.json")

    # We use a temporary shell script executed inside the pod to keep things clean
    cat <<EOF | kubectl exec -i -n "$namespace" vault-0 -- sh
        export VAULT_TOKEN="${root_token}"

        # Create an admin policy that has full permissions
        vault policy write admin - <<POLICY
path "*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
POLICY

        # Always configure userpass unless DISABLE_USERPASS is true
        if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
            if ! vault auth list | grep -q "userpass/"; then
                vault auth enable userpass
            fi
            # Create or update the admin user with the password 'changeit' and assign the admin policy
            vault write auth/userpass/users/admin password=changeit policies=admin

            # Give the admin entity profile metadata (full_name/email) so OIDC
            # providers that request the profile scope can render claims for
            # it. The login materializes the entity and its userpass alias;
            # VAULT_TOKEN must be unset for the login response to carry the
            # auth block, and the image has no jq, so parse with sed.
            unset VAULT_TOKEN
            admin_entity_id=\$(vault login -format=json -method=userpass username=admin password=changeit 2>/dev/null | sed -n 's/.*"entity_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
            export VAULT_TOKEN="${root_token}"
            if [ -n "\$admin_entity_id" ]; then
                printf '{"id":"%s","name":"admin","metadata":{"full_name":"Administrator","email":"admin@rd.localhost"}}' "\$admin_entity_id" | vault write identity/entity/id/\$admin_entity_id - >/dev/null
            fi

            # Shared OIDC profile scope: OIDC clients (e.g. agentgateway)
            # request scope=profile and Vault renders name/email from entity
            # metadata set above (or by 'create-user'). Missing metadata
            # renders as an empty claim, never an error.
            vault write identity/oidc/scope/profile \
                description="Profile information (name, email)" \
                template='{"name": {{identity.entity.metadata.full_name}}, "email": {{identity.entity.metadata.email}}}' >/dev/null
        else
            # If someone explicitly disables it later, we could optionally disable the auth path,
            # but for a dev script, it's safer to just skip creating/updating it.
            if vault auth list | grep -q "userpass/"; then
                vault auth disable userpass || true
            fi
        fi

        # Configure OIDC if credentials are provided
        if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
            if ! vault auth list | grep -q "oidc/"; then
                vault auth enable oidc
            fi

            vault write auth/oidc/config \\
                oidc_discovery_url="https://accounts.google.com" \\
                oidc_client_id="${OIDC_CLIENT_ID:-}" \\
                oidc_client_secret="${OIDC_CLIENT_SECRET:-}" \\
                default_role="admin"

            vault write auth/oidc/role/admin \\
                bound_audiences="${OIDC_CLIENT_ID:-}" \\
                allowed_redirect_uris="https://vault.rogue.io/ui/vault/auth/oidc/oidc/callback" \\
                allowed_redirect_uris="http://localhost:8250/oidc/callback" \\
                user_claim="sub" \\
                policies="admin"
        fi
EOF

    local auth_methods=""
    if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
        auth_methods="Username/Password"
    fi
    if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
        if [ -n "$auth_methods" ]; then
            auth_methods="$auth_methods and OIDC"
        else
            auth_methods="OIDC"
        fi
    fi

    log_info "Vault configured successfully with ${auth_methods:-No} authentication."
}

create_user_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"
    local username="" password="" full_name="" email="" policies="default"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --password)
                password="$2"
                shift 2
                ;;
            --full-name)
                full_name="$2"
                shift 2
                ;;
            --email)
                email="$2"
                shift 2
                ;;
            --policies)
                policies="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                if [ -z "$username" ]; then
                    username="$1"
                    shift
                else
                    log_error "Unexpected argument: $1"
                    show_help
                    exit 1
                fi
                ;;
        esac
    done

    if [ -z "$username" ]; then
        fatal "Usage: ldx vault create-user <username> [--password <pass>] [--full-name <name>] [--email <email>] [--policies <list>]"
    fi

    if [ -z "$password" ]; then
        read -rsp "Password for '${username}' (unchanged if left empty): " password
        echo ""
    fi

    if [ ! -f "${VAULT_DIR}/keys.json" ]; then
        fatal "Vault root token not found at ${VAULT_DIR}/keys.json. Run 'setup' first."
    fi
    local root_token
    root_token=$(jq -r .root_token "${VAULT_DIR}/keys.json")

    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true
    [ "$sealed" = "false" ] || fatal "Vault is sealed. Run 'unseal' first."

    log_info "Creating user '${username}' in Vault..."
    local out
    out=$(cat <<'REMOTE_EOF' | kubectl exec -i -n "$namespace" vault-0 -- sh -s "$root_token" "$username" "$password" "$full_name" "$email" "$policies"
root_token="$1"
username="$2"
password="$3"
full_name="$4"
email="$5"
policies="$6"
export VAULT_TOKEN="$root_token"

# Ensure userpass auth is enabled.
if ! vault auth list | grep -q "userpass/"; then
    vault auth enable userpass >/dev/null
fi

# Ensure the shared OIDC `profile` scope exists (canonical owner: 'setup';
# this also repairs installs that predate it). Idempotent.
vault write identity/oidc/scope/profile \
    description="Profile information (name, email)" \
    template='{"name": {{identity.entity.metadata.full_name}}, "email": {{identity.entity.metadata.email}}}' >/dev/null

# Create the user, or update it without touching the password when blank.
if [ -n "$password" ]; then
    vault write auth/userpass/users/$username password="$password" policies="$policies" >/dev/null
else
    if ! vault read auth/userpass/users/$username >/dev/null 2>&1; then
        echo "ERROR: user '$username' does not exist and no --password was given" >&2
        exit 1
    fi
    vault write auth/userpass/users/$username policies="$policies" >/dev/null
fi

userpass_accessor=$(vault read -format=json sys/auth | tr -d '[:space:]' \
    | sed -n 's/.*"userpass\/":{"accessor":"\([^"]*\)".*/\1/p')

# Some identity endpoints (entity create, entity-alias, alias lookup) only
# accept POST, which the Vault CLI (PUT) cannot reach. The Vault image ships
# wget but not curl; dev hosts usually the other way round.
http_post() {
    if command -v wget >/dev/null 2>&1; then
        wget -q -O - --header="X-Vault-Token: $root_token" --post-data="$2" "$1" 2>/dev/null
    else
        curl -s -X POST -H "X-Vault-Token: $root_token" -d "$2" "$1" 2>/dev/null
    fi
}
vault_api() { http_post "${VAULT_ADDR:-http://127.0.0.1:8200}/v1/$1" "$2"; }

# Find the user's entity. A login materializes entity+alias (VAULT_TOKEN must
# be unset for the response to carry the auth block); with a blank password,
# fall back to an alias lookup.
unset VAULT_TOKEN
entity_id=$(vault login -format=json -method=userpass username="$username" password="$password" 2>/dev/null \
    | sed -n 's/.*"entity_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
export VAULT_TOKEN="$root_token"
if { [ -z "$entity_id" ] || [ "$entity_id" = "null" ]; } && [ -n "$userpass_accessor" ]; then
    entity_id=$(vault_api identity/lookup/entity \
        "{\"alias_name\":\"$username\",\"alias_mount_accessor\":\"$userpass_accessor\"}" \
        | sed -n 's/.*"id":"\([^"]*\)".*/\1/p') || true
fi

# Read-modify-write the entity metadata so unrelated keys survive (a PUT
# replaces the whole metadata map). The image has no jq/curl; parse the two
# keys we manage with sed and rewrite the full map.
meta=""
existing=""
if [ -n "$entity_id" ] && [ "$entity_id" != "null" ]; then
    existing=$(vault read -format=json identity/entity/id/$entity_id 2>/dev/null) || true
fi
if [ -n "$existing" ]; then
    kept_name=$(printf '%s' "$existing" | sed -n 's/.*"full_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    kept_email=$(printf '%s' "$existing" | sed -n 's/.*"email"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    [ -z "$full_name" ] && full_name="$kept_name"
    [ -z "$email" ] && email="$kept_email"
fi
[ -n "$full_name" ] && meta="\"full_name\":\"$full_name\""
[ -n "$email" ] && meta="${meta:+$meta,}\"email\":\"$email\""

if [ -n "$entity_id" ] && [ "$entity_id" != "null" ]; then
    if [ -n "$meta" ]; then
        # Keep the entity name Vault assigned (auto-generated names look like
        # entity_xxxx once the alias exists).
        entity_name=$(vault read -format=json -field=name identity/entity/id/$entity_id 2>/dev/null | tr -d '"')
        [ -n "$entity_name" ] && [ "$entity_name" != "null" ] || entity_name="$username"
        printf '{"id":"%s","name":"%s","metadata":{%s}}' "$entity_id" "$entity_name" "$meta" \
            | vault write identity/entity/id/$entity_id - >/dev/null
    fi
    echo "OK ${entity_id}"
elif [ -n "$meta" ] && [ -n "$userpass_accessor" ]; then
    # Entity does not exist yet (user never logged in): create it with the
    # metadata and bind the userpass alias so the first login maps onto it.
    entity_id=$(vault_api identity/entity \
        "{\"name\":\"$username\",\"metadata\":{$meta}}" \
        | sed -n 's/.*"id":"\([^"]*\)".*/\1/p')
    if [ -n "$entity_id" ]; then
        vault_api identity/entity-alias \
            "{\"name\":\"$username\",\"canonical_id\":\"$entity_id\",\"mount_accessor\":\"$userpass_accessor\"}" >/dev/null
        echo "OK ${entity_id}"
    else
        echo "OK no-login"
    fi
else
    echo "OK no-login"
fi
REMOTE_EOF
)

    local status entity_id
    entity_id=$(printf '%s\n' "$out" | sed -n 's/^OK //p')
    status="$entity_id"
    if printf '%s\n' "$out" | grep -q '^ERROR'; then
        fatal "Vault: $(printf '%s\n' "$out" | sed -n 's/^ERROR: //p')"
    fi

    log_info "User '${username}' ready (policies: ${policies})."
    if [ "$status" = "no-login" ]; then
        log_warn "Could not log in with the given password; entity metadata was left unchanged."
    elif [ -n "$entity_id" ]; then
        log_info "Entity: ${entity_id} (full_name: ${full_name:-unchanged}, email: ${email:-unchanged})"
        if [ -n "$full_name" ] || [ -n "$email" ]; then
            log_info "OIDC clients requesting the 'profile' scope will receive these as name/email claims."
        fi
    fi
}

# --- Version tracking ---------------------------------------------------------
# ${VAULT_DIR}/version.json records the chart/app version this workspace's
# setup pins and what the cluster actually runs, so later upgrades (or a
# downgrade) know the base. Written by setup and upgrade.
record_vault_version() {
    local chart="$1" app="$2" prev_chart="${3:-}" prev_app="${4:-}"
    init_dirs
    local file="${VAULT_DIR}/version.json" updated
    updated=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [ -f "$file" ] && jq -e . "$file" >/dev/null 2>&1; then
        [ -n "$prev_chart" ] || prev_chart=$(jq -r '.base_chart // empty' "$file")
        [ -n "$prev_app" ] || prev_app=$(jq -r '.base_app // empty' "$file")
    fi
    jq -n \
        --arg base_chart "$chart" --arg base_app "$app" \
        --arg chart "$chart" --arg app "$app" \
        --arg prev_chart "$prev_chart" --arg prev_app "$prev_app" \
        --arg updated "$updated" \
        '{base_chart: $base_chart, base_app: $base_app,
          chart: $chart, app: $app,
          previous_chart: (if $prev_chart == "" then null else $prev_chart end),
          previous_app: (if $prev_app == "" then null else $prev_app end),
          updated_at: $updated}' > "$file"
}

# Chart version of the installed helm release, e.g. "0.33.0" (empty if absent).
vault_release_chart() {
    helm list -n commons -o json 2>/dev/null \
        | jq -r '.[] | select(.name == "vault") | .chart' 2>/dev/null \
        | sed -n 's/^vault-//p'
}

# Status of the installed helm release ("deployed", "failed", ...).
vault_release_status() {
    helm list -n commons -o json 2>/dev/null \
        | jq -r '.[] | select(.name == "vault") | .status' 2>/dev/null
}

# Vault app version the running pod reports (empty if not running).
vault_live_app_version() {
    kubectl get pod vault-0 -n commons \
        -o jsonpath='{.spec.containers[?(@.name=="vault")].image}' 2>/dev/null \
        | sed -n 's/.*:\(.*\)$/\1/p'
}

# App version pinned by a given chart version (empty when unknown).
vault_app_version_for_chart() {
    helm show chart hashicorp/vault --version "$1" 2>/dev/null \
        | sed -n 's/^appVersion:[[:space:]]*//p' | tr -d '"' | head -1
}

# Storage backend declared in the generated Vault config: "raft" | "file".
vault_storage_type() {
    local type
    type=$(kubectl get configmap vault-config -n commons -o jsonpath='{.data.config}' 2>/dev/null \
        | sed -n 's/.*storage "\([a-z-]*\)".*/\1/p' | head -1)
    printf '%s' "${type:-file}"
}

snapshot_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"
    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true
    [ "$sealed" = "false" ] || fatal "Vault is sealed (or not running). Run 'unseal' first."

    init_dirs
    local chart storage snap
    chart=$(vault_release_chart)
    storage=$(vault_storage_type)
    snap="${VAULT_DIR}/snapshots/$(date +%Y%m%d-%H%M%S)-vault${chart:+-${chart}}-${storage}.snap"

    case "$storage" in
        raft)
            log_info "Saving Raft snapshot..."
            kubectl exec -n "$namespace" vault-0 -- vault operator raft snapshot save /tmp/raft.snap >/dev/null
            kubectl cp "${namespace}/vault-0:/tmp/raft.snap" "$snap" >/dev/null
            kubectl exec -n "$namespace" vault-0 -- rm -f /tmp/raft.snap 2>/dev/null || true
            ;;
        file)
            # File backend (chart default for standalone): the data dir on the
            # PVC *is* the database. Tar it out of the pod. Writes during the
            # tar are rare on a dev box; for a hard-consistent copy seal first.
            log_info "Backing up file storage (/vault/data)..."
            kubectl exec -n "$namespace" vault-0 -- tar czf /tmp/filedb.tgz -C /vault data >/dev/null
            kubectl cp "${namespace}/vault-0:/tmp/filedb.tgz" "$snap" >/dev/null
            kubectl exec -n "$namespace" vault-0 -- rm -f /tmp/filedb.tgz 2>/dev/null || true
            ;;
        *)
            fatal "Unsupported storage backend '${storage}'. Snapshot manually."
            ;;
    esac

    if [ ! -s "$snap" ]; then
        rm -f "$snap"
        fatal "Snapshot is empty; the file was not written."
    fi
    log_info "Snapshot saved (${storage}): ${snap} ($(wc -c < "$snap" | tr -d ' ') bytes)"
}

upgrade_vault() {
    require_command "helm"
    require_command "kubectl"
    require_command "jq"

    local namespace="commons"
    local target="" dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                [ -z "$target" ] || { log_error "Unexpected argument: $1"; exit 1; }
                target="$1"
                shift
                ;;
        esac
    done

    helm repo add hashicorp https://helm.releases.hashicorp.com --force-update >/dev/null 2>&1 || true
    helm repo update hashicorp >/dev/null 2>&1 || helm repo update >/dev/null

    local current status
    current=$(vault_release_chart)
    status=$(vault_release_status)
    [ -n "$current" ] || fatal "Vault is not installed. Run 'setup' first."

    if [ -z "$target" ]; then
        target=$(helm search repo hashicorp/vault -l 2>/dev/null | awk 'NR==2 {print $2}')
        [ -n "$target" ] || fatal "Could not determine the latest chart version."
        log_info "No version given; latest chart is ${target} (Vault $(vault_app_version_for_chart "$target"))."
    fi

    # A release already at the target and healthy is a no-op. A release stuck
    # at the target but 'failed' (a prior interrupted upgrade) is re-driven.
    if [ "$target" = "$current" ] && [ "$status" = "deployed" ]; then
        log_info "Vault already at chart ${target}; nothing to do."
        record_vault_version "$target" "$(vault_live_app_version)"
        return
    fi

    local target_app current_app
    target_app=$(vault_app_version_for_chart "$target")
    current_app=$(vault_live_app_version)
    log_info "Upgrade plan: chart ${current} (Vault ${current_app:-unknown}) -> chart ${target} (Vault ${target_app:-unknown})"

    if $dry_run; then
        helm upgrade vault hashicorp/vault \
            --version "$target" \
            --namespace "$namespace" \
            "${VAULT_HELM_SET_ARGS[@]}" \
            --dry-run=client >/dev/null
        log_info "--dry-run: manifest rendered successfully; no changes applied."
        return
    fi

    # Pre-flight: Vault must be healthy and unsealed, and we must hold a
    # snapshot. Vault refuses to start against storage written by a newer
    # version, so the snapshot (or the PVC contents) is the rollback path.
    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true
    [ "$sealed" = "false" ] || fatal "Vault is sealed (or not running). Run 'unseal' first."

    snapshot_vault
    local snap
    snap=$(ls -t "${VAULT_DIR}/snapshots/"*.snap | head -1)

    log_info "Upgrading Vault Helm release to chart ${target}..."
    # --force-conflicts: the injector controller re-writes the webhook caBundle
    # outside helm; helm 4's server-side apply otherwise refuses the field.
    # No --wait: this chart rolls out OnDelete and its readiness probe fails
    # while sealed, so helm can never observe the new pod ready on its own.
    if ! helm upgrade vault hashicorp/vault \
        --version "$target" \
        --namespace "$namespace" \
        "${VAULT_HELM_SET_ARGS[@]}" \
        --force-conflicts; then
        log_error "helm upgrade failed. Pods that are not ready:"
        report_unready_pods "$namespace"
        fatal "helm upgrade failed. Snapshot: ${snap}. Fix and re-run, or consult docs/vault.md."
    fi

    # Drive the OnDelete rollout ourselves: recreate the pod so it picks up the
    # new image, then unseal (a fresh pod starts sealed).
    if [ "$(vault_live_app_version)" != "${target_app:-$current_app}" ]; then
        log_info "Recreating vault-0 to load the new image..."
        kubectl delete pod vault-0 -n "$namespace" --wait=true
    fi
    log_info "Waiting for the vault container to start..."
    kubectl wait --for=condition=ContainersReady pod/vault-0 -n "$namespace" --timeout=180s \
        || log_warn "vault-0 not ContainersReady yet; attempting unseal anyway."

    log_info "Re-unsealing (new pod starts sealed)..."
    unseal_vault

    # Wait for readiness now that it is unsealed (readiness = `vault status`).
    if ! kubectl wait --for=condition=Ready pod/vault-0 -n "$namespace" --timeout=120s; then
        fatal "vault-0 did not become Ready after unseal. Snapshot for rollback: ${snap}. See docs/vault.md."
    fi

    # Post checks: app version and that the OIDC issuer config survived the
    # version move. The provider discovery endpoint needs no token, so a 200
    # proves the identity backend read the (persisted) OIDC configuration.
    local new_app ok=true
    new_app=$(vault_live_app_version)
    log_info "Running pod image tag: ${new_app:-unknown} (expected ${target_app:-unknown})"

    if kubectl exec -n "$namespace" vault-0 -- sh -c \
        'wget -qO- http://127.0.0.1:8200/v1/identity/oidc/provider/agentgateway/.well-known/openid-configuration 2>/dev/null || curl -s http://127.0.0.1:8200/v1/identity/oidc/provider/agentgateway/.well-known/openid-configuration' \
        | grep -q '"issuer"'; then
        log_info "OIDC issuer responds: identity data intact."
    else
        log_warn "OIDC issuer did not respond after upgrade."
        ok=false
    fi

    record_vault_version "$target" "${new_app:-$target_app}" "$current" "$current_app"

    if $ok; then
        log_info "Upgrade complete: chart ${target}, Vault ${new_app:-$target_app}."
        log_info "Log in at https://agentgateway.rd.localhost/ui and confirm SSO still works."
    else
        fatal "Upgrade applied but a smoke check failed. Snapshot for rollback: ${snap}. See docs/vault.md."
    fi
}

seal_vault() {
    require_command "kubectl"

    local namespace="commons"
    log_info "Sealing Vault..."
    kubectl exec -n "$namespace" vault-0 -- vault operator seal
    log_info "Vault is now sealed."
}

uninstall_vault() {
    require_command "helm"
    require_command "kubectl"

    local namespace="commons"

    log_info "Uninstalling Vault Helm release..."
    helm uninstall vault -n "$namespace" || true

    log_info "Removing MutatingWebhookConfiguration..."
    kubectl delete mutatingwebhookconfiguration vault-agent-injector-cfg --ignore-not-found

    log_info "Removing Vault PVC to ensure clean re-install..."
    kubectl delete pvc -n "$namespace" data-vault-0 --ignore-not-found

    log_info "Removing local Vault keys..."
    rm -rf "${VAULT_DIR}"

    log_info "Vault uninstall complete. The 'commons' namespace was not deleted."
}

main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        setup)
            export DISABLE_USERPASS=false
            # Parse additional arguments for setup
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --oidc-client-id)
                        export OIDC_CLIENT_ID="$2"
                        shift 2
                        ;;
                    --oidc-client-secret)
                        export OIDC_CLIENT_SECRET="$2"
                        shift 2
                        ;;
                    --disable-userpass)
                        export DISABLE_USERPASS=true
                        shift 1
                        ;;
                    *)
                        log_error "Unknown option: $1"
                        show_help
                        exit 1
                        ;;
                esac
            done
            setup_vault
            ;;
        status)
            status_vault
            ;;
        unseal)
            unseal_vault
            ;;
        seal)
            seal_vault
            ;;
        create-user)
            create_user_vault "$@"
            ;;
        upgrade)
            upgrade_vault "$@"
            ;;
        snapshot)
            snapshot_vault
            ;;
        uninstall)
            uninstall_vault
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            show_help
            exit 1
            ;;
    esac
}

main "$@"