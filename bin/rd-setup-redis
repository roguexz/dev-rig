#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    echo "Usage: $(basename "$0") <install|uninstall>"
    echo ""
    echo "Commands:"
    echo "  install    Install Redis using Helm and expose port 6379 to the host."
    echo "  uninstall  Remove the Redis deployment."
}

install_redis() {
    require_command "helm"
    require_command "kubectl"

    log_info "Adding Bitnami Helm repository..."
    helm repo add bitnami https://charts.bitnami.com/bitnami --force-update
    helm repo update bitnami

    local namespace="commons"
    kubectl create namespace "$namespace" --dry-run=client -o yaml | kubectl apply -f -

    log_info "Installing Redis..."
    helm upgrade --install redis bitnami/redis \
        --namespace "$namespace" \
        --set architecture=standalone \
        --set auth.enabled=false \
        --wait

    log_info "Exposing Redis via NodePort (Host Port 6379)..."
    cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Service
metadata:
  name: redis-host-access
  namespace: commons
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: redis
  ports:
    - port: 6379
      targetPort: 6379
      nodePort: 30379
EOF

    cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: Service
metadata:
  name: redis-lb
  namespace: commons
spec:
  type: LoadBalancer
  selector:
    app.kubernetes.io/name: redis
  ports:
    - port: 6379
      targetPort: 6379
EOF

    log_info "Redis installation complete."
    log_info "Redis should now be accessible at localhost:6379 from your host machine."
}

uninstall_redis() {
    require_command "helm"
    require_command "kubectl"

    local namespace="commons"

    log_info "Uninstalling Redis..."
    kubectl delete service redis-host-access -n "$namespace" --ignore-not-found
    kubectl delete service redis-lb -n "$namespace" --ignore-not-found
    helm uninstall redis -n "$namespace" || true

    log_info "Redis uninstall complete. The 'commons' namespace was not deleted."
}

main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        install)
            install_redis
            ;;
        uninstall)
            uninstall_redis
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            show_help
            exit 1
            ;;
    esac
}

main "$@"