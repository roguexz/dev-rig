#!/usr/bin/env bash
#
# ldx-skill - Manage Agent Skills bundled with dev-rig
#

set -euo pipefail

get_script_dir() {
  local SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SOURCE" ]; do
    local DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
  done
  cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR="$(get_script_dir)"

if [ -f "${SCRIPT_DIR}/lib/common.sh" ]; then
  source "${SCRIPT_DIR}/lib/common.sh"
else
  log_info() { echo -e "\033[0;32m[INFO]\033[0m $1"; }
  log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
  log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1"; }
  fatal() { log_error "$1"; exit 1; }
fi

AGENTS_SKILLS_DIR="${HOME}/.agents/skills"

# Determine source skills directory
find_source_skills_dir() {
  local repo_dir="$(cd "${SCRIPT_DIR}/.." &>/dev/null && pwd)"
  if [ -d "${repo_dir}/skills" ]; then
    echo "${repo_dir}/skills"
  elif [ -d "${SCRIPT_DIR}/../share/ldx/skills" ]; then
    echo "${SCRIPT_DIR}/../share/ldx/skills"
  elif [ -d "${HOME}/.local/share/ldx/skills" ]; then
    echo "${HOME}/.local/share/ldx/skills"
  else
    fatal "Could not locate bundled skills directory."
  fi
}

SOURCE_SKILLS_DIR="$(find_source_skills_dir)"

show_help() {
  echo "ldx skill - Manage Agent Skills bundled in dev-rig"
  echo ""
  echo "Usage: $(basename "$0") <command> [options]"
  echo ""
  echo "Commands:"
  echo "  list, ls                           List bundled skills and installation status"
  echo "  install <skill-name|--all> [opts]  Install skill into \$HOME/.agents/skills/"
  echo "  uninstall <skill-name|--all> [opts] Remove skill from \$HOME/.agents/skills/"
  echo "  info <skill-name>                  Display metadata and details for a skill"
  echo ""
  echo "Install Options:"
  echo "  --link, -l         Symlink skill directory instead of copying"
  echo "  --skip-hooks       Skip execution of pre/post install scripts"
  echo "  --force, -f        Force install even if pre-install hook fails"
  echo ""
  echo "Uninstall Options:"
  echo "  --skip-hooks       Skip execution of pre/post uninstall scripts"
}

get_skill_description() {
  local skill_dir="$1"
  local skill_md="${skill_dir}/SKILL.md"
  if [ -f "$skill_md" ]; then
    # Extract description line from frontmatter
    grep -i "^description:" "$skill_md" | head -n 1 | sed 's/^description:[[:space:]]*//I' | tr -d '"' || echo "No description"
  else
    echo "No SKILL.md file found"
  fi
}

list_skills() {
  log_info "Bundled Agent Skills (Source: ${SOURCE_SKILLS_DIR}):"
  echo ""
  printf "  %-20s %-15s %s\n" "SKILL NAME" "STATUS" "DESCRIPTION"
  printf "  %-20s %-15s %s\n" "----------" "------" "-----------"

  if [ ! -d "$SOURCE_SKILLS_DIR" ] || [ -z "$(ls -A "$SOURCE_SKILLS_DIR" 2>/dev/null)" ]; then
    echo "  (No skills found in ${SOURCE_SKILLS_DIR})"
    return 0
  fi

  for skill_path in "${SOURCE_SKILLS_DIR}"/*; do
    [ -d "$skill_path" ] || continue
    local skill_name="$(basename "$skill_path")"
    local target_path="${AGENTS_SKILLS_DIR}/${skill_name}"
    local status="Not Installed"

    if [ -L "$target_path" ]; then
      status="Linked"
    elif [ -d "$target_path" ]; then
      status="Installed"
    fi

    local desc="$(get_skill_description "$skill_path")"
    printf "  %-20s %-15s %s\n" "$skill_name" "$status" "$desc"
  done
  echo ""
}

run_hook() {
  local hook_path="$1"
  local skill_name="$2"
  local skill_src="$3"
  local skill_dst="$4"
  local mode="$5"
  local ignore_failure="${6:-false}"

  if [ -x "$hook_path" ]; then
    log_info "Executing hook: ${hook_path}"
    export SKILL_NAME="$skill_name"
    export SKILL_SOURCE_DIR="$skill_src"
    export SKILL_TARGET_DIR="$skill_dst"
    export INSTALL_MODE="$mode"

    if ! "$hook_path"; then
      if [ "$ignore_failure" = "true" ]; then
        log_warn "Hook '${hook_path}' failed, but --force was specified. Continuing..."
      else
        fatal "Hook '${hook_path}' failed with non-zero exit status."
      fi
    fi
  elif [ -f "$hook_path" ]; then
    log_warn "Hook '${hook_path}' exists but is not executable. Running 'chmod +x ${hook_path}'..."
    chmod +x "$hook_path"
    run_hook "$hook_path" "$skill_name" "$skill_src" "$skill_dst" "$mode" "$ignore_failure"
  fi
}

install_single_skill() {
  local skill_name="$1"
  local mode="$2"
  local skip_hooks="$3"
  local force="$4"

  local src_dir="${SOURCE_SKILLS_DIR}/${skill_name}"
  local dst_dir="${AGENTS_SKILLS_DIR}/${skill_name}"

  if [ ! -d "$src_dir" ]; then
    fatal "Skill '${skill_name}' not found in bundled skills directory."
  fi

  if [ ! -f "${src_dir}/SKILL.md" ]; then
    fatal "Skill '${skill_name}' is missing mandatory SKILL.md file."
  fi

  mkdir -p "$AGENTS_SKILLS_DIR"

  log_info "Installing skill '${skill_name}' to '${dst_dir}' (mode: ${mode})..."

  # 1. Pre-install hook
  if [ "$skip_hooks" = "false" ]; then
    local pre_hook="${src_dir}/hooks/pre-install.sh"
    [ -f "$pre_hook" ] || pre_hook="${src_dir}/pre-install.sh"
    [ -f "$pre_hook" ] && run_hook "$pre_hook" "$skill_name" "$src_dir" "$dst_dir" "$mode" "$force"
  fi

  # 2. Perform copy or symlink
  if [ -e "$dst_dir" ] || [ -L "$dst_dir" ]; then
    log_info "Removing existing installation at '${dst_dir}'..."
    rm -rf "$dst_dir"
  fi

  if [ "$mode" = "link" ]; then
    ln -s "$src_dir" "$dst_dir"
    log_info "Linked '${src_dir}' -> '${dst_dir}'"
  else
    cp -R "$src_dir" "$dst_dir"
    log_info "Copied '${src_dir}' -> '${dst_dir}'"
  fi

  # 3. Post-install hook
  if [ "$skip_hooks" = "false" ]; then
    local post_hook="${dst_dir}/hooks/post-install.sh"
    [ -f "$post_hook" ] || post_hook="${dst_dir}/post-install.sh"
    [ -f "$post_hook" ] && run_hook "$post_hook" "$skill_name" "$src_dir" "$dst_dir" "$mode" "false"
  fi

  log_info "Successfully installed skill '${skill_name}'!"
}

uninstall_single_skill() {
  local skill_name="$1"
  local skip_hooks="$2"

  local src_dir="${SOURCE_SKILLS_DIR}/${skill_name}"
  local dst_dir="${AGENTS_SKILLS_DIR}/${skill_name}"

  if [ ! -d "$dst_dir" ] && [ ! -L "$dst_dir" ]; then
    log_warn "Skill '${skill_name}' is not installed at '${dst_dir}'."
    return 0
  fi

  log_info "Uninstalling skill '${skill_name}'..."

  # 1. Pre-uninstall hook
  if [ "$skip_hooks" = "false" ] && [ -d "$dst_dir" ]; then
    local pre_unhook="${dst_dir}/hooks/pre-uninstall.sh"
    [ -f "$pre_unhook" ] || pre_unhook="${dst_dir}/pre-uninstall.sh"
    [ -f "$pre_unhook" ] && run_hook "$pre_unhook" "$skill_name" "$src_dir" "$dst_dir" "uninstall" "false"
  fi

  # 2. Remove directory/symlink
  rm -rf "$dst_dir"
  log_info "Removed '${dst_dir}'"

  # 3. Post-uninstall hook
  if [ "$skip_hooks" = "false" ] && [ -d "$src_dir" ]; then
    local post_unhook="${src_dir}/hooks/post-uninstall.sh"
    [ -f "$post_unhook" ] && run_hook "$post_unhook" "$skill_name" "$src_dir" "$dst_dir" "uninstall" "false"
  fi

  log_info "Successfully uninstalled skill '${skill_name}'!"
}

show_info() {
  local skill_name="$1"
  local src_dir="${SOURCE_SKILLS_DIR}/${skill_name}"
  local dst_dir="${AGENTS_SKILLS_DIR}/${skill_name}"

  if [ ! -d "$src_dir" ]; then
    fatal "Skill '${skill_name}' not found."
  fi

  echo "Skill Information: ${skill_name}"
  echo "----------------------------------------"
  echo "Source Location : ${src_dir}"
  echo "Target Location : ${dst_dir}"
  
  if [ -L "$dst_dir" ]; then
    echo "Status          : Installed (Symlink)"
  elif [ -d "$dst_dir" ]; then
    echo "Status          : Installed (Copied)"
  else
    echo "Status          : Not Installed"
  fi

  echo "Description     : $(get_skill_description "$src_dir")"
  echo ""
  echo "Hooks Found:"
  [ -f "${src_dir}/hooks/pre-install.sh" ] && echo "  - pre-install.sh"
  [ -f "${src_dir}/hooks/post-install.sh" ] && echo "  - post-install.sh"
  [ -f "${src_dir}/hooks/pre-uninstall.sh" ] && echo "  - pre-uninstall.sh"
  [ -f "${src_dir}/hooks/post-uninstall.sh" ] && echo "  - post-uninstall.sh"
  echo ""
}

# --- Main Dispatch ---

if [ $# -lt 1 ]; then
  show_help
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  list|ls)
    list_skills
    ;;
  info)
    [ $# -lt 1 ] && fatal "Usage: ldx skill info <skill-name>"
    show_info "$1"
    ;;
  install)
    [ $# -lt 1 ] && fatal "Usage: ldx skill install <skill-name|--all> [options]"
    target_skill="$1"
    shift
    mode="copy"
    skip_hooks="false"
    force="false"

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --link|-l)
          mode="link"
          shift
          ;;
        --skip-hooks)
          skip_hooks="true"
          shift
          ;;
        --force|-f)
          force="true"
          shift
          ;;
        *)
          fatal "Unknown install flag: $1"
          ;;
      esac
    done

    if [ "$target_skill" = "--all" ] || [ "$target_skill" = "all" ]; then
      for s in "${SOURCE_SKILLS_DIR}"/*; do
        [ -d "$s" ] || continue
        install_single_skill "$(basename "$s")" "$mode" "$skip_hooks" "$force"
      done
    else
      install_single_skill "$target_skill" "$mode" "$skip_hooks" "$force"
    fi
    ;;
  uninstall)
    [ $# -lt 1 ] && fatal "Usage: ldx skill uninstall <skill-name|--all> [options]"
    target_skill="$1"
    shift
    skip_hooks="false"

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --skip-hooks)
          skip_hooks="true"
          shift
          ;;
        *)
          fatal "Unknown uninstall flag: $1"
          ;;
      esac
    done

    if [ "$target_skill" = "--all" ] || [ "$target_skill" = "all" ]; then
      for s in "${SOURCE_SKILLS_DIR}"/*; do
        [ -d "$s" ] || continue
        uninstall_single_skill "$(basename "$s")" "$skip_hooks"
      done
    else
      uninstall_single_skill "$target_skill" "$skip_hooks"
    fi
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    log_error "Unknown subcommand: ${COMMAND}"
    show_help
    exit 1
    ;;
esac
