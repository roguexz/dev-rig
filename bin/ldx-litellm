#!/usr/bin/env bash

set -euo pipefail

get_script_dir() {
  local SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SOURCE" ]; do
    local DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
  done
  cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR="$(get_script_dir)"
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    echo "Usage: $(basename "$0") <install|uninstall|sync-omlx>"
    echo ""
    echo "Commands:"
    echo "  install       Deploy LiteLLM proxy connected to PostgreSQL."
    echo "  uninstall     Remove LiteLLM proxy deployment and services."
    echo "  sync-omlx     Sync omlx models to LiteLLM proxy (requires STORE_MODEL_IN_DB)."
    echo "                  Stamps per-model capabilities (vision, token limits,"
    echo "                  reasoning efforts) and re-creates models whose caps drift."
    echo "                  Use --dry-run to preview changes without applying them."
}

ensure_database() {
    local namespace="commons"
    log_info "Ensuring PostgreSQL is running and LiteLLM database exists..."

    # Check if postgres pod is present in commons namespace
    if ! kubectl get pods -n "$namespace" -l app.kubernetes.io/name=postgresql &> /dev/null; then
        fatal "PostgreSQL pod not found in namespace '$namespace'. Please run 'ldx postgres install' first."
    fi

    # Find the primary postgres pod
    local pod_name
    pod_name=$(kubectl get pods -n "$namespace" -l app.kubernetes.io/name=postgresql,app.kubernetes.io/component=primary -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)

    if [ -z "$pod_name" ]; then
        pod_name="postgresql-0"
    fi

    local pg_pass="${POSTGRES_PASSWORD:-changeit}"

    # Check if database 'litellm' exists, create if missing
    log_info "Checking database 'litellm' on ${pod_name}..."
    if kubectl exec -n "$namespace" "$pod_name" -- env PGPASSWORD="$pg_pass" psql -U postgres -lqt | cut -d \| -f 1 | grep -qw litellm; then
        log_info "Database 'litellm' already exists."
    else
        log_info "Creating database 'litellm'..."
        kubectl exec -n "$namespace" "$pod_name" -- env PGPASSWORD="$pg_pass" psql -U postgres -c "CREATE DATABASE litellm;"
        kubectl exec -n "$namespace" "$pod_name" -- env PGPASSWORD="$pg_pass" psql -U postgres -d litellm -c "CREATE EXTENSION IF NOT EXISTS vector;"
        log_info "Database 'litellm' created successfully."
    fi
}

install_litellm() {
    require_command "kubectl"

    local namespace="commons"
    kubectl create namespace "$namespace" --dry-run=client -o yaml | kubectl apply -f -

    ensure_database

    log_info "Deploying LiteLLM Proxy with Thinking Token Filter..."

    cat <<EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: litellm-bundle
  namespace: ${namespace}
data:
  config.yaml: |
    litellm_settings:
      callbacks: ["strip_thinking.plugin"]
  strip_thinking.py: |
    import re
    from typing import Optional, Literal
    from litellm.integrations.custom_logger import CustomLogger

    class StripThinkingFilter(CustomLogger):
        THINK_REGEX = re.compile(r"", re.DOTALL)

        async def async_pre_call_hook(
            self,
            user_api_key_dict: dict,
            cache: any,
            data: dict,
            call_type: Literal["completion", "text_completion", "embeddings"]
        ) -> Optional[dict]:
            messages = data.get("messages", [])
            for msg in messages:
                # Strip dedicated reasoning parameter if forwarded by client
                if "reasoning_content" in msg:
                    del msg["reasoning_content"]
                # Strip inline thinking tokens from prior turns
                if isinstance(msg.get("content"), str):
                    msg["content"] = self.THINK_REGEX.sub("", msg["content"]).strip()
            return data

    plugin = StripThinkingFilter()
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: litellm
  namespace: ${namespace}
  labels:
    app: litellm
spec:
  replicas: 1
  selector:
    matchLabels:
      app: litellm
  template:
    metadata:
      labels:
        app: litellm
    spec:
      containers:
      - name: litellm
        image: ghcr.io/berriai/litellm:main-latest
        imagePullPolicy: IfNotPresent
        args:
        - "--config"
        - "/etc/litellm/config/config.yaml"
        - "--port"
        - "4000"
        env:
        - name: DATABASE_URL
          value: "postgresql://postgres:changeit@postgresql.commons.svc.cluster.local:5432/litellm"
        - name: LITELLM_MASTER_KEY
          value: "sk-changeit"
        - name: STORE_MODEL_IN_DB
          value: "True"
        - name: LITELLM_SALT_KEY
          value: "changeit"
        - name: PYTHONPATH
          value: "/etc/litellm/plugins"
        ports:
        - containerPort: 4000
          name: http
        volumeMounts:
        - name: bundle-storage
          mountPath: /etc/litellm/config/config.yaml
          subPath: config.yaml
        - name: bundle-storage
          mountPath: /etc/litellm/plugins/strip_thinking.py
          subPath: strip_thinking.py
        readinessProbe:
          httpGet:
            path: /health/readiness
            port: 4000
          initialDelaySeconds: 15
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /health/liveness
            port: 4000
          initialDelaySeconds: 15
          periodSeconds: 10
      volumes:
      - name: bundle-storage
        configMap:
          name: litellm-bundle
---
apiVersion: v1
kind: Service
metadata:
  name: litellm
  namespace: ${namespace}
spec:
  type: ClusterIP
  selector:
    app: litellm
  ports:
  - port: 4000
    targetPort: 4000
    name: http
---
apiVersion: v1
kind: Service
metadata:
  name: litellm-host-access
  namespace: ${namespace}
spec:
  type: NodePort
  selector:
    app: litellm
  ports:
  - port: 4000
    targetPort: 4000
    nodePort: 30400
---
apiVersion: v1
kind: Service
metadata:
  name: litellm-lb
  namespace: ${namespace}
spec:
  type: LoadBalancer
  selector:
    app: litellm
  ports:
  - port: 4000
    targetPort: 4000
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: litellm
  namespace: ${namespace}
spec:
  ingressClassName: traefik
  rules:
  - host: litellm.rd.localhost
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: litellm
            port:
              number: 4000
EOF

    log_info "Waiting for LiteLLM deployment to be ready..."
    kubectl wait --for=condition=available deployment/litellm -n "$namespace" --timeout=120s

    log_info "LiteLLM Proxy installation complete."
    log_info "LiteLLM UI and API are accessible at: https://litellm.rd.localhost or http://localhost:4000"
    log_info "In-cluster DNS: http://litellm.commons.svc.cluster.local:4000"
    log_info "Admin Master Key: sk-changeit"
}

sync_omlx_models() {
    require_command "kubectl"
    require_command "jq"

    local dry_run=false
    local check_drift=true
    for arg in "$@"; do
        case "$arg" in
            --dry-run)  dry_run=true ;;
            --no-drift) check_drift=false ;;
            *) fatal "Unknown option for sync-omlx: $arg" ;;
        esac
    done

    local namespace="commons"
    local settings_file="${HOME}/.omlx/settings.json"

    if [ ! -f "$settings_file" ]; then
        fatal "omlx settings file not found at: $settings_file"
    fi

    # --- Read omlx port from settings.json ---
    local omlx_port
    omlx_port=$(jq -r '.server.port // 5033' "$settings_file")
    log_info "omlx server port: $omlx_port"

    # --- Read omlx API key from settings.json (skip verification if needed) ---
    local omlx_api_key
    omlx_api_key=$(jq -r '.auth.api_key // ""' "$settings_file")
    local omlx_skip_verify
    omlx_skip_verify=$(jq -r '.auth.skip_api_key_verification // false' "$settings_file")

    local omlx_base="http://localhost:${omlx_port}"
    log_info "omlx base URL: $omlx_base"

    # --- Local omlx config files (source of per-model capability metadata) ---
    local model_settings_file="${HOME}/.omlx/model_settings.json"
    local omlx_dir
    omlx_dir=$(jq -r '.model.model_dir // (.model.model_dirs[0]) // (env.HOME + "/.omlx/models")' "$settings_file")

    # --- Determine LiteLLM endpoint (try ingress first, then NodePort) ---
    local litellm_url=""
    if command -v kubectl &> /dev/null; then
        # Try ingress host
        litellm_url=$(kubectl get ingress -n "$namespace" litellm -o jsonpath='{.spec.rules[0].host}' 2>/dev/null || true)
        if [ -n "$litellm_url" ]; then
            litellm_url="https://${litellm_url}"
        else
            # Fallback to NodePort on localhost
            local node_port
            node_port=$(kubectl get svc -n "$namespace" litellm-host-access -o jsonpath='{.spec.ports[0].nodePort}' 2>/dev/null || true)
            if [ -n "$node_port" ]; then
                litellm_url="http://localhost:${node_port}"
            fi
        fi
    fi

    # Fallback to localhost:4000 if we couldn't determine the URL
    if [ -z "$litellm_url" ]; then
        litellm_url="http://localhost:4000"
    fi
    log_info "LiteLLM URL: $litellm_url"

    local litellm_master_key="sk-changeit"
    local auth_header="Authorization: Bearer ${litellm_master_key}"

    # --- Fetch omlx models ---
    log_info "Fetching models from omlx..."
    local omlx_models_raw
    if [ "$omlx_skip_verify" = "true" ]; then
        omlx_models_raw=$(curl -sS "${omlx_base}/v1/models" 2>&1) || fatal "Failed to fetch models from omlx at ${omlx_base}/v1/models: ${omlx_models_raw}"
    else
        omlx_models_raw=$(curl -sS -H "Authorization: Bearer ${omlx_api_key}" "${omlx_base}/v1/models" 2>&1) || fatal "Failed to fetch models from omlx at ${omlx_base}/v1/models: ${omlx_models_raw}"
    fi

    if [ -z "$omlx_models_raw" ]; then
        fatal "Failed to fetch models from omlx at ${omlx_base}/v1/models (empty response)"
    fi

    # Extract model IDs (exclude helper models like MarkItDown)
    local HELPER_MODELS='["MarkItDown","nomicai-modernbert"]'
    local omlx_models=()
    while IFS= read -r model_id; do
        # Skip helper/non-LLM models
        case "$model_id" in
            MarkItDown|nomicai-modernbert) continue ;;
        esac
        omlx_models+=("$model_id")
    done < <(echo "$omlx_models_raw" | jq -r '.data[].id')

    log_info "Found ${#omlx_models[@]} omlx models"

    # --- Build per-model capability metadata from local omlx config ---
    # Resolution order for each capability:
    #   max_input_tokens  : per-model max_context_window (model_settings.json)
    #                       -> global sampling.max_context_window (settings.json)
    #   max_output_tokens : global sampling.max_tokens (omlx has no per-model override)
    #   supports_vision   : vision keys in <model_dir>/config.json (embedding arches excluded)
    #   reasoning efforts : thinking_budget_enabled / enable_thinking per model
    local alias_dirs_file caps_file
    alias_dirs_file=$(mktemp)
    caps_file=$(mktemp)
    # Cleanup via an EXIT trap: a RETURN trap here can fire after these locals
    # go out of scope, which trips `set -u` and leaves the temp files behind.
    trap 'rm -f "${alias_dirs_file:-}" "${caps_file:-}"' EXIT

    # Map model id -> model directory. omlx stores the per-model settings in
    # model_settings.json keyed by the model directory's basename; the entry's
    # model_alias is the id served on /v1/models (null => the key itself is the
    # id). config.json for a key lives at models/<org-or-flat>/<key>/config.json.
    if [ -d "$omlx_dir" ] && [ -f "$model_settings_file" ]; then
        jq -r '.models // {} | to_entries[]
            | [(.value.model_alias // .key), .key] | @tsv' "$model_settings_file" 2>/dev/null \
        | while IFS=$'\t' read -r ms_alias ms_key; do
            [ -n "$ms_alias" ] || continue
            # Resolve the directory that actually holds this model's config.json.
            local cfg_path
            cfg_path=$(find "$omlx_dir" -maxdepth 3 -type d -name "$ms_key" 2>/dev/null | head -n1)
            [ -n "$cfg_path" ] && printf '%s\t%s\n' "$ms_alias" "$cfg_path"
        done > "$alias_dirs_file"
    fi

    # Global token limits from omlx settings.json
    local g_ctx g_max_tokens
    g_ctx=$(jq -r '.sampling.max_context_window // 98304' "$settings_file")
    g_max_tokens=$(jq -r '.sampling.max_tokens // 16384' "$settings_file")

    # Compute the desired model_info block for each omlx model:
    # one line of JSON {"id":..., "model_info":{...}} per model.
    : > "$caps_file"
    for model_id in "${omlx_models[@]}"; do
        local dir dir_key ms_entry vision reasoning ctx
        dir=$(awk -F '\t' -v a="$model_id" '$1==a {print $2; exit}' "$alias_dirs_file")
        dir_key=""
        if [ -n "$dir" ]; then
            dir_key=$(basename "$dir")
        else
            # No alias entry; fall back to a model_settings key equal to the id
            if jq -e --arg k "$model_id" '.models[$k]' "$model_settings_file" >/dev/null 2>&1; then
                dir_key="$model_id"
            fi
            dir="${omlx_dir}/${model_id}"
        fi

        ms_entry='{}'
        if [ -n "$dir_key" ]; then
            ms_entry=$(jq -c --arg k "$dir_key" '.models[$k] // {}' "$model_settings_file" 2>/dev/null || echo '{}')
        fi

        # Vision: config.json carries vision config and the model is not an embedder.
        vision=false
        if [ -f "${dir}/config.json" ]; then
            if jq -e '
                    (.architectures[0] // "") as $arch
                    | ((($arch | test("Embedding|ModernBert")) | not)
                       and (has("vision_config")
                          or has("image_token_index")
                          or has("vision_start_token_id")))
                ' "${dir}/config.json" >/dev/null 2>&1; then
                vision=true
            fi
        fi

        reasoning=$(jq -r '((.thinking_budget_enabled // false) or (.enable_thinking // false))' <<<"$ms_entry")
        ctx=$(jq -r --argjson g "$g_ctx" '.max_context_window // $g' <<<"$ms_entry")

        jq -cn --arg id "$model_id" \
            --argjson vision "$vision" \
            --argjson reasoning "$reasoning" \
            --argjson ctx "$ctx" \
            --argjson max_out "$g_max_tokens" \
            '{
                id: $id,
                model_info: {
                    supports_vision: $vision,
                    max_input_tokens: $ctx,
                    max_output_tokens: $max_out
                }
                + (if $reasoning then {
                    supported_openai_params: [
                        "messages", "model", "max_tokens", "temperature", "top_p",
                        "top_k", "n", "stop", "stream", "seed",
                        "presence_penalty", "frequency_penalty",
                        "tools", "tool_choice", "parallel_tool_calls",
                        "response_format", "logprobs", "top_logprobs",
                        "reasoning_effort"
                    ],
                    reasoning_effort_levels: ["low", "medium", "high"]
                } else {} end)
            }' >> "$caps_file"
    done

    # --- Fetch existing LiteLLM models that use the omlx credential ---
    log_info "Fetching existing omlx models from LiteLLM..."
    local litellm_models_raw
    litellm_models_raw=$(curl -sS -H "$auth_header" "${litellm_url}/model/info" 2>&1) || fatal "Failed to fetch models from LiteLLM at ${litellm_url}/model/info: ${litellm_models_raw}"

    if [ -z "$litellm_models_raw" ]; then
        fatal "Failed to fetch models from LiteLLM at ${litellm_url}/model/info (empty response)"
    fi

    # Build associative array of existing omlx models: model_name -> litellm_model_id
    declare -A existing_models
    while IFS='|' read -r model_name litellm_model_id; do
        existing_models["$model_name"]="$litellm_model_id"
    done < <(echo "$litellm_models_raw" | jq -r '.data[] | select(.litellm_params.litellm_credential_name == "omlx") | "\(.model_name)|\(.model_info.id)"')

    log_info "Found ${#existing_models[@]} existing omlx models in LiteLLM"

    # Index existing deployments by underlying omlx model id, and capture their
    # capability fields (normalized) for drift comparison.
    declare -A existing_by_model=()   # omlx model id -> "registered_name|litellm_id"
    declare -A existing_caps=()      # omlx model id -> normalized capability JSON
    while IFS=$'\t' read -r um_model um_name um_id um_caps; do
        existing_by_model["$um_model"]="$um_name|$um_id"
        existing_caps["$um_model"]="$um_caps"
    done < <(echo "$litellm_models_raw" | jq -r '
        .data[]
        | select(.litellm_params.litellm_credential_name == "omlx")
        | [ .litellm_params.model,
            .model_name,
            .model_info.id,
            (.model_info | {
                supports_vision: (.supports_vision // false),
                max_input_tokens,
                max_output_tokens,
                supported_openai_params: ((.supported_openai_params // []) | sort),
                reasoning_effort_levels: ((.reasoning_effort_levels // []) | sort)
              } | tojson)
          ] | @tsv')

    # --- Determine to-create, to-recreate (capability drift), and to-delete sets ---
    local -a to_create=()
    local -a to_delete=()
    local -a to_recreate=()
    # litellm_model_id -> model_name as registered on LiteLLM (for readable output)
    declare -A delete_names=()
    # omlx model id -> registered name to reuse when re-creating after drift
    declare -A recreate_names=()

    # Desired capabilities for a model, normalized the same way as existing_caps.
    desired_caps() {
        jq -c --arg id "$1" '
            select(.id == $id) | .model_info | {
                supports_vision: (.supports_vision // false),
                max_input_tokens,
                max_output_tokens,
                supported_openai_params: ((.supported_openai_params // []) | sort),
                reasoning_effort_levels: ((.reasoning_effort_levels // []) | sort)
            }' "$caps_file" | head -n1
    }

    # One-line summary of the capabilities that will be stamped on a model
    caps_summary() {
        jq -r --arg id "$1" '
            select(.id == $id) | .model_info |
            "vision=" + (.supports_vision|tostring)
            + " ctx=" + (.max_input_tokens|tostring)
            + " out=" + (.max_output_tokens|tostring)
            + " reasoning=" + (if .reasoning_effort_levels then ((.reasoning_effort_levels // []) | join(",")) else "no" end)
        ' "$caps_file" | head -n1
    }

    # Models in omlx that are not yet in LiteLLM, or whose capabilities drifted
    for model_id in "${omlx_models[@]}"; do
        local proposed_name="omlx-${model_id}"
        if [ -n "${existing_by_model[$model_id]:-}" ]; then
            local want have
            want=$(desired_caps "$model_id")
            have="${existing_caps[$model_id]}"
            if [ "$check_drift" = "true" ] && [ "$want" != "$have" ]; then
                # /model/update cannot persist model_info changes, so refresh via delete+create
                local reg_name="${existing_by_model[$model_id]%%|*}"
                local reg_id="${existing_by_model[$model_id]##*|}"
                to_recreate+=("$model_id")
                recreate_names["$model_id"]="$reg_name"
                to_create+=("$model_id")
                to_delete+=("$reg_id")
                delete_names["$reg_id"]="$reg_name"
            fi
        elif [ -z "${existing_models[$proposed_name]+x}" ]; then
            to_create+=("$model_id")
        fi
    done

    # Models in litellm (omlx-credentialed) whose underlying model is gone from omlx
    for um in "${!existing_by_model[@]}"; do
        if [[ ! " ${omlx_models[*]} " =~ " ${um} " ]]; then
            local reg_id="${existing_by_model[$um]##*|}"
            # Skip ids already queued for deletion by a capability refresh above
            local already=false
            for d in "${to_delete[@]:-}"; do
                [ "$d" = "$reg_id" ] && already=true && break
            done
            [ "$already" = "true" ] && continue
            to_delete+=("$reg_id")
            delete_names["$reg_id"]="${existing_by_model[$um]%%|*}"
        fi
    done

    log_info "Models to create: ${#to_create[@]} (${#to_recreate[@]} refresh)"
    log_info "Models to delete: ${#to_delete[@]}"

    # --- Interactive approval ---
    # Capability refreshes keep their registered name; only genuinely new
    # models are offered for naming.
    local -a new_models=()
    for model_id in "${to_create[@]:-}"; do
        [ -z "$model_id" ] && continue
        local is_refresh=false
        for r in "${to_recreate[@]:-}"; do
            [ "$r" = "$model_id" ] && is_refresh=true && break
        done
        [ "$is_refresh" = "true" ] || new_models+=("$model_id")
    done

    if [ ${#to_recreate[@]} -gt 0 ]; then
        echo ""
        echo "Models to REFRESH (capability update, same name):"
        for model_id in "${to_recreate[@]}"; do
            echo "  ${recreate_names[$model_id]}  ->  $(caps_summary "$model_id")"
        done
    fi

    if [ ${#new_models[@]} -gt 0 ]; then
        echo ""
        echo "Models to ADD to LiteLLM:"
        for i in "${!new_models[@]}"; do
            local model_id="${new_models[$i]}"
            echo "  [$((i+1))] ${model_id}  ->  $(caps_summary "$model_id")"
        done

        # Prompt per model: skip it, accept the lowercase default name, or
        # type a custom one.
        declare -A model_names
        local skipped=0
        local ii
        for ii in "${!new_models[@]}"; do
            local model_id="${new_models[$ii]}"
            local default_name="omlx-${model_id,,}"

            if [ "$dry_run" = "true" ]; then
                echo "  Would add '${model_id}' as '${default_name}' (real run: 'n' skips)"
                model_names["$model_id"]="$default_name"
                continue
            fi

            echo ""
            read -r -p "  Add '${model_id}'? [Y/n]: " add_answer
            case "$add_answer" in
                n|N)
                    echo "  Skipping '${model_id}'"
                    skipped=$((skipped + 1))
                    unset 'new_models[ii]'
                    # Drop it from to_create so it is never registered.
                    local ci
                    for ci in "${!to_create[@]}"; do
                        [ "${to_create[$ci]}" = "$model_id" ] && unset 'to_create[ci]'
                    done
                    continue
                    ;;
            esac

            read -r -p "  Enter name for '${model_id}' [${default_name}]: " custom_name
            if [ -z "$custom_name" ]; then
                custom_name="$default_name"
            fi

            # Handle naming conflicts with existing litellm models
            if [ -n "${existing_models[$custom_name]+x}" ]; then
                echo "  WARNING: Name '${custom_name}' already exists in LiteLLM (ID: ${existing_models[$custom_name]})"
                read -r -p "  Overwrite? (y/N): " overwrite
                if [ "$overwrite" != "y" ] && [ "$overwrite" != "Y" ]; then
                    echo "  Skipping '${model_id}'"
                    skipped=$((skipped + 1))
                    unset "new_models[$ii]"
                    # Drop it from to_create so it is never registered.
                    local ci
                    for ci in "${!to_create[@]}"; do
                        [ "${to_create[$ci]}" = "$model_id" ] && unset "to_create[$ci]"
                    done
                    continue
                fi
                # Mark for deletion of the old one
                to_delete+=("${existing_models[$custom_name]}")
                delete_names["${existing_models[$custom_name]}"]="$custom_name"
            fi

            model_names["$model_id"]="$custom_name"
        done

        if [ "$skipped" -gt 0 ]; then
            log_info "Skipped ${skipped} new model(s) by user choice."
        fi
    else
        echo ""
        log_info "No new models to add."
    fi

    if [ ${#to_delete[@]} -gt 0 ]; then
        echo ""
        echo "Models to DELETE from LiteLLM:"
        for model_id in "${to_delete[@]}"; do
            [ -z "$model_id" ] && continue
            local model_name="${delete_names[$model_id]:-}"
            if [ -n "$model_name" ]; then
                echo "  ${model_name}  [ID: ${model_id}]"
            else
                echo "  [ID: ${model_id}]"
            fi
        done
    fi

    if [ ${#to_create[@]} -eq 0 ] && [ ${#to_delete[@]} -eq 0 ] && [ ${#to_recreate[@]} -eq 0 ]; then
        log_info "Nothing to do. omlx and LiteLLM models are in sync."
        return 0
    fi

    if [ "$dry_run" = "true" ]; then
        echo ""
        log_info "[DRY RUN] No changes will be made. Run without --dry-run to apply."
        return 0
    fi

    echo ""
    read -r -p "Proceed with these changes? (y/N): " confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
        log_info "Aborted by user."
        return 0
    fi

    # --- Ensure omlx credential exists ---
    log_info "Checking for 'omlx' credential..."
    local cred_exists
    cred_exists=$(curl -sS -H "$auth_header" "${litellm_url}/credentials" 2>&1 | jq -r '.credentials[] | select(.credential_name == "omlx") | .credential_name' 2>/dev/null || true)

    if [ -z "$cred_exists" ]; then
        log_info "Creating 'omlx' credential..."
        local cred_payload
        if [ "$omlx_skip_verify" = "true" ]; then
            cred_payload=$(jq -n --arg base "${omlx_base}" '{
                credential_name: "omlx",
                credential_values: { api_base: $base }
            }')
        else
            cred_payload=$(jq -n --arg base "${omlx_base}" --arg key "${omlx_api_key}" '{
                credential_name: "omlx",
                credential_values: { api_base: $base, api_key: $key }
            }')
        fi

        local cred_resp
        cred_resp=$(curl -sS -X POST "${litellm_url}/credentials" \
            -H "$auth_header" \
            -H "Content-Type: application/json" \
            -d "$cred_payload" 2>&1) || fatal "Failed to create omlx credential: ${cred_resp}"

        log_info "Created 'omlx' credential."
    else
        log_info "'omlx' credential already exists."
    fi

    # --- Delete obsolete models (and refresh targets) FIRST ---
    # Deleting before creating avoids duplicate registered names when a model
    # is being refreshed (same name, updated capabilities).
    local deleted=0
    for model_id in "${to_delete[@]}"; do
        [ -z "$model_id" ] && continue

        local model_label="${delete_names[$model_id]:-$model_id}"

        log_info "Deleting model '${model_label}' (ID: ${model_id})..."
        local resp
        resp=$(curl -sS -X POST "${litellm_url}/model/delete" \
            -H "$auth_header" \
            -H "Content-Type: application/json" \
            -d "{\"id\": \"${model_id}\"}" 2>&1) || { log_warn "Failed to delete model '${model_label}' (ID: ${model_id}): ${resp}"; continue; }

        if [ -n "$resp" ]; then
            log_info "Deleted model '${model_label}'."
            deleted=$((deleted + 1))
        else
            log_warn "Failed to delete model '${model_label}' (empty response)."
        fi
    done

    # --- Create new models (and re-create refreshed ones with new capabilities) ---
    local created=0
    for model_id in "${to_create[@]}"; do
        [ -z "$model_id" ] && continue

        local model_name="${model_names[$model_id]:-${recreate_names[$model_id]:-omlx-${model_id}}}"

        log_info "Adding model '${model_name}' -> ${model_id}..."

        local payload
        payload=$(jq -n --arg name "$model_name" --arg model "$model_id" \
            --slurpfile caps <(cat "$caps_file") '{
            model_name: $name,
            litellm_params: {
                model: $model,
                custom_llm_provider: "openai",
                litellm_credential_name: "omlx"
            },
            model_info: ([$caps[] | select(.id == $model) | .model_info] | first // {})
        }')

        local resp
        resp=$(curl -sS -X POST "${litellm_url}/model/new" \
            -H "$auth_header" \
            -H "Content-Type: application/json" \
            -d "$payload" 2>&1) || { log_warn "Failed to create '${model_name}': ${resp}"; continue; }

        if [ -n "$resp" ]; then
            log_info "Created '${model_name}'."
            created=$((created + 1))
        else
            log_warn "Failed to create '${model_name}' (empty response)."
        fi
    done

    echo ""
    log_info "Sync complete: ${created} created, ${deleted} deleted, ${#to_recreate[@]} refreshed."
}

uninstall_litellm() {
    require_command "kubectl"

    local namespace="commons"

    log_info "Uninstalling LiteLLM Proxy..."
    kubectl delete deployment litellm -n "$namespace" --ignore-not-found
    kubectl delete service litellm litellm-host-access litellm-lb -n "$namespace" --ignore-not-found
    kubectl delete ingress litellm -n "$namespace" --ignore-not-found

    log_info "LiteLLM uninstall complete. The 'commons' namespace and PostgreSQL database were not deleted."
}

main() {
    # Handle --help / -h before any subcommand
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    case "$1" in
        --help|-h)
            show_help
            exit 0
            ;;
    esac

    local subcommand="$1"
    shift

    case "$subcommand" in
        install)
            if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
                echo "Usage: $(basename "$0") install"
                echo ""
                echo "Deploy LiteLLM proxy connected to PostgreSQL."
                exit 0
            fi
            install_litellm
            ;;
        uninstall)
            if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
                echo "Usage: $(basename "$0") uninstall"
                echo ""
                echo "Remove LiteLLM proxy deployment and services."
                exit 0
            fi
            uninstall_litellm
            ;;
        sync-omlx)
            if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
                echo "Usage: $(basename "$0") sync-omlx [--dry-run] [--no-drift]"
                echo ""
                echo "Sync omlx models to LiteLLM proxy."
                echo ""
                echo "Options:"
                echo "  --dry-run    Preview changes without applying them."
                echo "  --no-drift   Skip capability drift detection (only add/remove"
                echo "               models, never re-create ones whose caps changed)."
                exit 0
            fi
            sync_omlx_models "$@"
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
