#!/usr/bin/env bash
#
# ldx - Top-level CLI dispatcher for Local Development Experience & system tools
#

set -euo pipefail

# Get the physical directory of the current script to locate library and subcommands
get_script_dir() {
  local SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SOURCE" ]; do
    local DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
  done
  cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR="$(get_script_dir)"

# Source common utilities if available
if [ -f "${SCRIPT_DIR}/lib/common.sh" ]; then
  source "${SCRIPT_DIR}/lib/common.sh"
else
  log_info() { echo -e "\033[0;32m[INFO]\033[0m $1"; }
  log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
  log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1"; }
  fatal() { log_error "$1"; exit 1; }
fi

show_help() {
  echo "ldx - Local Development Experience CLI"
  echo ""
  echo "Usage: $(basename "$0") <command> [subcommand] [flags]"
  echo ""
  echo "CLI Management:"
  echo "  install       Install ldx binaries into local bin directory (default: copy mode, use --link for symlinks)"
  echo ""
  echo "System & Security Utilities:"
  echo "  cvescan       Manage system-wide automated Grype vulnerability scanner"
  echo ""
  echo "Local Kubernetes & Infrastructure Setup (Rancher Desktop):"
  echo "  tls           Manage TLS certificates and Traefik configuration"
  echo "  certmanager   Install and configure cert-manager"
  echo "  otel          Deploy and configure OpenTelemetry LGTM stack"
  echo "  redis         Deploy Redis stack"
  echo "  postgres      Deploy PostgreSQL with pgvector extension"
  echo "  vault         Manage local Vault deployment"
  echo "  litellm       Deploy LiteLLM proxy"
  echo ""
  echo "Run '$(basename "$0") <command> help' for detailed usage of a specific command."
}

install_binaries() {
  local target_dir=""
  local mode="copy" # Default mode is copy

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)
        target_dir="$2"
        shift 2
        ;;
      --link|-l|--mode=link|--mode=symlink)
        mode="link"
        shift
        ;;
      --copy|--mode=copy)
        mode="copy"
        shift
        ;;
      --help|-h)
        echo "Usage: ldx install [options]"
        echo ""
        echo "Options:"
        echo "  --dir <path>  Target directory (default: \$HOME/.local/bin or \$HOME/bin)"
        echo "  --copy        Install by copying files (default)"
        echo "  --link, -l    Install by creating symlinks to repository source"
        exit 0
        ;;
      *)
        fatal "Unknown install flag: $1"
        ;;
    esac
  done

  if [ -z "$target_dir" ]; then
    if [ -d "${HOME}/.local/bin" ] || [ ! -d "${HOME}/bin" ]; then
      target_dir="${HOME}/.local/bin"
    else
      target_dir="${HOME}/bin"
    fi
  fi

  mkdir -p "$target_dir"

  log_info "Installing ldx commands into '${target_dir}' using ${mode} mode..."

  local scripts=("ldx" "ldx-cvescan" "ldx-certmanager" "ldx-litellm" "ldx-otel" "ldx-postgres" "ldx-redis" "ldx-tls" "ldx-vault")

  if [ "$mode" = "copy" ]; then
    for script in "${scripts[@]}"; do
      if [ -f "${SCRIPT_DIR}/${script}" ]; then
        cp "${SCRIPT_DIR}/${script}" "${target_dir}/${script}"
        chmod +x "${target_dir}/${script}"
        log_info "Copied ${script} -> ${target_dir}/${script}"
      fi
    done
    if [ -d "${SCRIPT_DIR}/lib" ]; then
      mkdir -p "${target_dir}/lib"
      cp -R "${SCRIPT_DIR}/lib/"* "${target_dir}/lib/"
      log_info "Copied lib/ utilities -> ${target_dir}/lib/"
    fi
  else
    for script in "${scripts[@]}"; do
      if [ -f "${SCRIPT_DIR}/${script}" ]; then
        ln -sf "${SCRIPT_DIR}/${script}" "${target_dir}/${script}"
        chmod +x "${SCRIPT_DIR}/${script}"
        log_info "Linked ${script} -> ${target_dir}/${script}"
      fi
    done
    if [ -d "${SCRIPT_DIR}/lib" ]; then
      mkdir -p "${target_dir}/lib"
      for libfile in "${SCRIPT_DIR}/lib/"*; do
        local libname="$(basename "$libfile")"
        ln -sf "$libfile" "${target_dir}/lib/${libname}"
      done
      log_info "Linked lib/ utilities -> ${target_dir}/lib/"
    fi
  fi

  log_info "Installation complete!"

  # Check if target_dir is in PATH
  case ":$PATH:" in
    *":${target_dir}:"*)
      log_info "'${target_dir}' is already in your PATH."
      ;;
    *)
      log_warn "'${target_dir}' is NOT currently in your PATH."
      log_warn "Add the following line to your shell configuration (~/.zshrc or ~/.bashrc):"
      echo -e "\n  export PATH=\"${target_dir}:\$PATH\"\n"
      ;;
  esac
}

if [ $# -lt 1 ]; then
  show_help
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  install)
    install_binaries "$@"
    exit 0
    ;;
  cvescan|tls|certmanager|otel|redis|postgres|vault|litellm)
    EXEC_SCRIPT="${SCRIPT_DIR}/ldx-${COMMAND}"
    ;;
  help|-h|--help)
    show_help
    exit 0
    ;;
  *)
    log_error "Unknown command: ${COMMAND}"
    show_help
    exit 1
    ;;
esac

if [ ! -x "${EXEC_SCRIPT}" ]; then
  if [ -f "${EXEC_SCRIPT}" ]; then
    log_warn "Script '${EXEC_SCRIPT}' exists but is not executable. Run 'chmod +x ${EXEC_SCRIPT}'."
    exit 1
  else
    log_error "Command handler '${EXEC_SCRIPT}' was not found."
    exit 1
  fi
fi

exec "${EXEC_SCRIPT}" "$@"
