#!/usr/bin/env bash
# ldx-help: infra Deploy and configure OpenTelemetry LGTM stack (alias for 'ldx k8s --services otel')
#
# ldx-otel - Thin alias for the declarative platform stack.
# The Grafana OTel LGTM stack is a subchart of ldx-local-platform; see 'ldx k8s'.
#
set -euo pipefail

# Locate the dev-rig checkout (LDX_HOME) from this command's real path.
_LDX_SELF="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${_LDX_SELF}")"
export LDX_HOME="$(cd "${SCRIPT_DIR}/../.." && pwd)"
source "${LDX_HOME}/bin/lib/common.sh"

show_help() {
    echo "Usage: $(basename "$0") <install|uninstall>"
    echo ""
    echo "Commands:"
    echo "  install    Install the all-in-one Grafana OTel LGTM stack."
    echo "  uninstall  Remove the OTel stack."
    echo ""
    echo "Alias for 'ldx k8s up/down --services otel'. Authelia OIDC SSO is"
    echo "detected automatically at install time. For flags, status and diffs"
    echo "use 'ldx k8s' directly."
}

case "${1:-}" in
    install)
        exec "${LDX_HOME}/bin/ldx" k8s up --services otel "${@:2}"
        ;;
    uninstall)
        exec "${LDX_HOME}/bin/ldx" k8s down --services otel "${@:2}"
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        show_help
        exit 1
        ;;
    *)
        log_error "Unknown subcommand: $1"
        show_help
        exit 1
        ;;
esac
