#!/usr/bin/env bash
# ldx-help: infra Configure the local opencode harness from Bifrost models

set -euo pipefail

# Locate the dev-rig checkout (LDX_HOME) from this command's real path.
_LDX_SELF="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${_LDX_SELF}")"
export LDX_HOME="$(cd "${SCRIPT_DIR}/../.." && pwd)"
source "${LDX_HOME}/bin/lib/common.sh"

# Hostname (Traefik Ingress) the Bifrost LLM endpoint is served on.
# Keep in sync with bin/ldx-bifrost.
BIFROST_HOST="bifrost.rd.localhost"
# ConfigMap holding the synced oMLX provider config (fragment of the gateway config).
BIFROST_PROVIDERS_CM="bifrost-providers"
# Provider id written into the opencode config for the Bifrost gateway.
# Models are prefixed with 'bifrost-' so they're distinguishable from direct
# omlx models ('omlx/<model-id>') in the model list.
PROVIDER_ID="bifrost"

# oMLX local files.
OMLX_DIR="${HOME}/.omlx"
OMLX_SETTINGS="${OMLX_DIR}/settings.json"
OMLX_MODEL_SETTINGS="${OMLX_DIR}/model_settings.json"

# Target harness config.
OPENCODE_CONFIG="${HOME}/.config/opencode/opencode.jsonc"

# Virtual client key cached by 'ldx bifrost api-key'.
BIFROST_KEY_CACHE="${CACHE_DIR}/bifrost/api_key"

# Helper-model filtering lives in ldx.harness.opencode (single source:
# build_manifest applies it).

show_help() {
    echo "Usage: $(basename "$0") <sync>"
    echo ""
    echo "Commands:"
    echo "  sync        Sync Bifrost provider config + omlx settings into the"
    echo "              local opencode config (~/.config/opencode/opencode.jsonc)."
    echo ""
    echo "Options for sync:"
    echo "  --dry-run             Show the merged config without writing it."
    echo "  --default-model <id>  Default coding model (id as served by the"
    echo "                        gateway). Skips the interactive prompt."
    echo "  --keep-stale          Keep provider models the gateway no longer serves"
    echo "                        instead of pruning them."
    echo ""
    echo "Notes:"
    echo "  - The gateway config comes from the ConfigMap written by"
    echo "    'ldx bifrost sync-omlx'; run that first (or re-run it to refresh)."
    echo "  - The gateway injects the omlx API key upstream, so the opencode"
    echo "    config uses a virtual client key for LLM routes."
    echo "  - Bifrost models are 'bifrost/bifrost-<model-id>' (distinguishable"
    echo "    from direct omlx models 'omlx/<model-id>')."
    echo "  - JSONC comments in the existing config are not preserved; a backup is"
    echo "    written to opencode.jsonc.bak before overwriting."
}

# ---------------------------------------------------------------------------
# Data collection
# ---------------------------------------------------------------------------

# Reads the synced oMLX model route names from the gateway's ConfigMap,
# one per line, helpers excluded. Bifrost serves models as 'omlx/<model-id>'
# (provider/model format), so we just return the raw model ids from omlx.
get_gateway_models() {
    local namespace providers_fragment
    namespace=$(ldx_namespace bifrost)
    providers_fragment=$(kubectl get configmap "$BIFROST_PROVIDERS_CM" -n "$namespace" \
        -o jsonpath='{.data.providers\.json}' 2>/dev/null) || true
    if [ -z "$providers_fragment" ]; then
        # No providers synced yet; fall back to querying omlx directly.
        local settings_file="${HOME}/.omlx/settings.json"
        if [ ! -f "$settings_file" ]; then
            return 1
        fi
        local omlx_port omlx_api_key omlx_skip_verify
        omlx_port=$(jq -r '.server.port // 5033' "$settings_file")
        omlx_api_key=$(jq -r '.auth.api_key // ""' "$settings_file")
        omlx_skip_verify=$(jq -r '.auth.skip_api_key_verification // false' "$settings_file")
        local omlx_base="http://localhost:${omlx_port}"
        local models_raw
        if [ "$omlx_skip_verify" = "true" ]; then
            models_raw=$(curl -sS "${omlx_base}/v1/models" 2>/dev/null) || return 1
        else
            models_raw=$(curl -sS -H "Authorization: Bearer ${omlx_api_key}" "${omlx_base}/v1/models" 2>/dev/null) || return 1
        fi
        if [ -z "$models_raw" ]; then
            return 1
        fi
        echo "$models_raw" | jq -r '.data[].id' | grep -v 'MarkItDown\|nomicai-modernbert'
        return 0
    fi
    # Providers are synced; check if omlx is configured. If so, query omlx
    # directly for the current model list (the ConfigMap just confirms the
    # provider is configured, it doesn't list individual models).
    if printf '%s' "$providers_fragment" | jq -e '.omlx' >/dev/null 2>&1; then
        local settings_file="${HOME}/.omlx/settings.json"
        if [ ! -f "$settings_file" ]; then
            return 1
        fi
        local omlx_port omlx_api_key omlx_skip_verify
        omlx_port=$(jq -r '.server.port // 5033' "$settings_file")
        omlx_api_key=$(jq -r '.auth.api_key // ""' "$settings_file")
        omlx_skip_verify=$(jq -r '.auth.skip_api_key_verification // false' "$settings_file")
        local omlx_base="http://localhost:${omlx_port}"
        local models_raw
        if [ "$omlx_skip_verify" = "true" ]; then
            models_raw=$(curl -sS "${omlx_base}/v1/models" 2>/dev/null) || return 1
        else
            models_raw=$(curl -sS -H "Authorization: Bearer ${omlx_api_key}" "${omlx_base}/v1/models" 2>/dev/null) || return 1
        fi
        if [ -z "$models_raw" ]; then
            return 1
        fi
        echo "$models_raw" | jq -r '.data[].id' | grep -v 'MarkItDown\|nomicai-modernbert'
    fi
}

# Reads the current default model id (without provider prefix or #variant)
# from the existing opencode config, if any. Rendering: ldx.harness.opencode.
get_current_default() {
    [ -f "$OPENCODE_CONFIG" ] || return 0
    OPENCODE_CONFIG="$OPENCODE_CONFIG" PROVIDER_ID="$PROVIDER_ID" \
    PYTHONPATH="${LDX_HOME}/bin/lib" python3 -m ldx.harness.opencode current-default
}

# Builds the model manifest (one JSON object per line) from model ids on
# stdin, enriched from the omlx settings files. Helper/unknown/hidden models
# are skipped. Rendering: ldx.harness.opencode.
build_manifest() {
    local manifest="$1"
    : > "$manifest"
    OMLX_SETTINGS="$OMLX_SETTINGS" \
    OMLX_MODEL_SETTINGS="$OMLX_MODEL_SETTINGS" \
    OMLX_MODELS_DIR="${OMLX_DIR}/models" \
    PYTHONPATH="${LDX_HOME}/bin/lib" python3 -m ldx.harness.opencode build-manifest \
        > "$manifest"
}

# ---------------------------------------------------------------------------
# Default model selection
# ---------------------------------------------------------------------------

# Echoes the chosen model id. Priority: --default-model flag, current config
# (if still served), interactive prompt. Errors on non-TTY with no valid pick.
select_default_model() {
    local manifest="$1" flag="$2" current="$3"
    # Accept ids with or without the config-side 'agw-' prefix.
    flag="${flag#agw-}"
    local count
    count=$(wc -l < "$manifest" | tr -d '[:space:]')
    [ "$count" -gt 0 ] || fatal "No usable models found in the gateway list."

    if [ -n "$flag" ]; then
        if ! jq -e --arg id "$flag" 'select(.id == $id)' "$manifest" >/dev/null 2>&1; then
            log_error "Model '${flag}' is not served by the gateway. Available:"
            jq -r '.id' "$manifest" | sed 's/^/  - /' >&2
            exit 1
        fi
        printf '%s\n' "$flag"
        return 0
    fi

    if [ -n "$current" ] && jq -e --arg id "$current" 'select(.id == $id)' "$manifest" >/dev/null 2>&1; then
        printf '%s\n' "$current"
        return 0
    fi

    if [ ! -t 0 ]; then
        log_error "No default model configured and none selected with --default-model."
        log_error "Available models:" >&2
        jq -r '.id' "$manifest" | sed 's/^/  - /' >&2
        exit 1
    fi

    if [ -n "$current" ]; then
        log_warn "Previous default '${current}' is no longer served by the gateway."
    fi
    # stdout is captured by the caller's $(...); the menu must go to stderr
    # or the user is prompted to pick a number without ever seeing the list.
    echo "Models available through Bifrost:" >&2
    local i=0
    while IFS= read -r line; do
        i=$((i + 1))
        local flags=""
        [ "$(jq -r '.budget_enabled' <<<"$line")" = "true" ] && flags="${flags}thinking "
        [ "$(jq -r '.vision' <<<"$line")" = "true" ] && flags="${flags}vision "
        local ctx
        ctx=$(jq -r '.context' <<<"$line")
        printf '  [%d] %-32s %s %sctx\n' "$i" "$(jq -r '.id' <<<"$line")" "$flags" "$ctx" >&2
    done < "$manifest"

    local choice
    while true; do
        read -r -p "Default coding model [1]: " choice
        choice=${choice:-1}
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
            jq -r ".id" <(sed -n "${choice}p" "$manifest")
            return 0
        fi
        echo "Pick a number between 1 and ${count}." >&2
    done
}

# ---------------------------------------------------------------------------
# Config merge
# ---------------------------------------------------------------------------

# Merge the gateway provider into the existing config. Rendering:
# ldx.harness.opencode (emits {"config": ..., "meta": ...}).
merge_config() {
    local manifest="$1" default_id="$2" keep_stale="$3" client_key="$4"

    MANIFEST="$manifest" \
    DEFAULT_ID="$default_id" \
    KEEP_STALE="$keep_stale" \
    CLIENT_KEY="$client_key" \
    OPENCODE_CONFIG="$OPENCODE_CONFIG" \
    PROVIDER_ID="$PROVIDER_ID" \
    GATEWAY_BASE_URL="https://${BIFROST_HOST}/openai" \
    PYTHONPATH="${LDX_HOME}/bin/lib" python3 -m ldx.harness.opencode merge
}


# ---------------------------------------------------------------------------
# sync
# ---------------------------------------------------------------------------

sync_opencode() {
    require_command "kubectl"
    require_command "jq"
    require_command "python3"

    local dry_run=false default_flag="" keep_stale=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            --default-model) default_flag="${2:-}"; shift 2 ;;
            --keep-stale) keep_stale=true; shift ;;
            *) fatal "Unknown option for sync: $1" ;;
        esac
    done

    [ -f "$OMLX_MODEL_SETTINGS" ] || fatal "omlx model settings not found at: $OMLX_MODEL_SETTINGS"
    [ -f "$OMLX_SETTINGS" ] || fatal "omlx settings not found at: $OMLX_SETTINGS"

    log_info "Reading model routes from Bifrost..."
    local gateway_models
    gateway_models=$(get_gateway_models) || fatal "Could not read models from Bifrost. Run 'ldx bifrost sync-omlx' first (is bifrost installed?)."
    local gw_count
    gw_count=$(printf '%s\n' "$gateway_models" | grep -c . || true)
    log_info "Gateway serves ${gw_count} models."

    local manifest
    manifest=$(mktemp)
    # ${manifest:-} - the trap fires after an early set -e exit, once this
    # function's locals are gone.
    trap 'rm -f "${manifest:-}"' EXIT

    printf '%s\n' "$gateway_models" | build_manifest "$manifest"

    local count
    count=$(grep -c . "$manifest" || true)
    [ "$count" -gt 0 ] || fatal "No usable models after filtering helpers/hidden entries."
    log_info "Configuring ${count} models from omlx settings."

    local current default_id
    current=$(get_current_default)
    if [ "$dry_run" = true ] && [ -z "$default_flag" ]; then
        # Don't block a dry run on the interactive prompt; preview with the
        # current default if it's still served, otherwise the first model.
        if [ -n "$current" ] && jq -e --arg id "$current" 'select(.id == $id)' "$manifest" >/dev/null 2>&1; then
            default_id="$current"
        else
            default_id=$(head -n1 "$manifest" | jq -r '.id')
            log_warn "Dry run: no valid default configured; previewing with '${default_id}'."
        fi
    else
        default_id=$(select_default_model "$manifest" "$default_flag" "$current")
    fi

    local client_key=""
    client_key=$(
        ldx_secret_get_blob bifrost "$BIFROST_KEY_CACHE" api_key 2>/dev/null
    ) || true
    [ -n "$client_key" ] || fatal "No cached gateway API key (ldx/bifrost/api_key). The gateway enforces API keys; run 'ldx bifrost api-key' (or 'ldx bifrost sync-omlx') first."

    local result pruned had_comments model_ref
    result=$(merge_config "$manifest" "$default_id" "$keep_stale" "$client_key") || fatal "Failed to merge opencode config."
    # Bracket notation: jq 1.8.x rejects some bare field names after a dot.
    pruned=$(jq -r '.meta["pruned"] | join(", ")' <<<"$result")
    had_comments=$(jq -r '.meta["had_comments"]' <<<"$result")
    model_ref=$(jq -r '.meta["model"]' <<<"$result")

    if [ "$dry_run" = true ]; then
        log_info "Dry run - merged config would be:"
        jq . <<<"$(jq -r '.config' <<<"$result")" | sed -E 's/("apiKey"[[:space:]]*:[[:space:]]*")[^"]+(")/\1***REDACTED***\2/' | sed -E 's/(Bearer )[a-zA-Z0-9_-]+/\1***REDACTED***/'
        [ -n "$pruned" ] && log_info "Would prune stale models: ${pruned}"
        return 0
    fi

    if [ "$had_comments" = true ]; then
        log_warn "JSONC comments in ${OPENCODE_CONFIG} are not preserved on rewrite."
    fi
    mkdir -p "$(dirname "$OPENCODE_CONFIG")"
    if [ -f "$OPENCODE_CONFIG" ]; then
        cp "$OPENCODE_CONFIG" "${OPENCODE_CONFIG}.bak"
        log_info "Backed up existing config to ${OPENCODE_CONFIG}.bak"
    fi
    jq -r '.config' <<<"$result" > "${OPENCODE_CONFIG}.tmp"
    mv "${OPENCODE_CONFIG}.tmp" "$OPENCODE_CONFIG"

    log_info "Wrote provider '${PROVIDER_ID}' with ${count} models to ${OPENCODE_CONFIG}."
    log_info "Default model: ${model_ref}"
    log_info "Models are referenced as '${PROVIDER_ID}/bifrost-<model-id>' (distinguishable from direct omlx)."
    log_info "MCP is available at https://${BIFROST_HOST}/mcp (configure tools via the Bifrost UI)."
    [ -n "$pruned" ] && log_warn "Pruned stale models (no longer served by the gateway): ${pruned}"
    log_info "Done. Verify with: opencode models | grep ${PROVIDER_ID}/"
}

main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        sync|setup)
            sync_opencode "$@"
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
