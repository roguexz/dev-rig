#!/usr/bin/env bash
# ldx-help: infra Deploy PostgreSQL with pgvector (alias for 'ldx k8s --services postgres')
#
# ldx-postgres - Thin alias for the declarative platform stack.
# PostgreSQL is managed by the ldx-local-platform Helm chart; the local
# pgvector image is built by 'ldx k8s up' when missing. See 'ldx k8s'.
#
set -euo pipefail

# Locate the dev-rig checkout (LDX_HOME) from this command's real path.
_LDX_SELF="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${_LDX_SELF}")"
export LDX_HOME="$(cd "${SCRIPT_DIR}/../.." && pwd)"
source "${LDX_HOME}/bin/lib/common.sh"

show_help() {
    echo "Usage: $(basename "$0") <install|uninstall|status|print-password>"
    echo ""
    echo "Commands:"
    echo "  install          Install PostgreSQL with pgvector and expose port 5432 to the host."
    echo "  uninstall        Remove the PostgreSQL deployment and its data (PVC)."
    echo "  status           Show the PostgreSQL pod status, port-forward, and endpoints."
    echo "  print-password   Print the PostgreSQL password (raw value, stdout)."
    echo ""
    echo "Alias for 'ldx k8s up/down --services postgres' (uninstall adds"
    echo "--purge-data, matching the historical behavior). For flags and diffs"
    echo "use 'ldx k8s' directly."
}

# Prints the PostgreSQL password to stdout (raw, for composition:
# PGPASSWORD="$(ldx postgres print-password)" psql ...). The host secret store
# is the source of truth; legacy installs without one fall back to the chart's
# Kubernetes Secret.
print_password_postgres() {
    local password
    password=$(ldx_secret_get postgresql/credentials PASSWORD 2>/dev/null) || true

    if [ -z "$password" ]; then
        require_command "kubectl"
        local namespace key
        namespace="$(ldx_namespace postgresql)"
        for key in postgres-password postgresql-postgres-password; do
            password=$(kubectl get secret postgresql -n "$namespace" \
                -o "jsonpath={.data.${key}}" 2>/dev/null | base64 -d 2>/dev/null) || true
            [ -n "$password" ] && break
        done
    fi

    [ -n "$password" ] \
        || fatal "No PostgreSQL password found (host secret store ldx/postgresql/credentials/PASSWORD, Secret 'postgresql'). Run 'ldx postgres install' first."
    echo "$password"
}

# Shows the PostgreSQL deployment status, port-forward, and credentials.
status_postgres() {
    require_command "kubectl"

    local namespace
    namespace="$(ldx_namespace postgresql)"

    log_info "PostgreSQL status:"

    # Check if the pod exists and its phase.
    local phase ready
    phase=$(kubectl get pods -n "$namespace" -l app.kubernetes.io/name=postgresql \
        -o 'jsonpath={.items[0].status.phase}' 2>/dev/null) || true
    ready=$(kubectl get pods -n "$namespace" -l app.kubernetes.io/name=postgresql \
        -o 'jsonpath={.items[0].status.containerStatuses[0].ready}' 2>/dev/null) || true

    if [ -z "$phase" ]; then
        echo "  Pod: not installed"
        return 0
    fi
    echo "  Pod: ${phase} (ready: ${ready:-unknown})"

    # Show how to reach it; print-password reveals the credential.
    echo "  Host access: psql -h localhost -U postgres -p 5432"
    echo "  Credentials: postgres : 'ldx postgres print-password'"

    # Check if the LoadBalancer service is exposed.
    local lb_ip
    lb_ip=$(kubectl get service postgres-lb -n "$namespace" \
        -o 'jsonpath={.status.loadBalancer.ingress[0].ip}' 2>/dev/null) || true
    if [ -n "$lb_ip" ]; then
        echo "  LoadBalancer: ${lb_ip}:5432"
    fi

    # Check if the NodePort service is exposed.
    local node_port
    node_port=$(kubectl get service postgres-host-access -n "$namespace" \
        -o 'jsonpath={.spec.ports[0].nodePort}' 2>/dev/null) || true
    if [ -n "$node_port" ]; then
        echo "  NodePort: localhost:${node_port}"
    fi

    # Show the cluster address.
    local svc_ports
    svc_ports=$(kubectl get service postgresql -n "$namespace" \
        -o 'jsonpath={.spec.ports[0].port}' 2>/dev/null) || true
    if [ -n "$svc_ports" ]; then
        echo "  Cluster: postgresql.${namespace}.svc.cluster.local:${svc_ports}"
    fi
}

case "${1:-}" in
    install)
        exec "${LDX_HOME}/bin/ldx" k8s up --services postgres "${@:2}"
        ;;
    uninstall)
        exec "${LDX_HOME}/bin/ldx" k8s down --services postgres --purge-data "${@:2}"
        ;;
    status)
        status_postgres
        ;;
    print-password)
        print_password_postgres
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        show_help
        exit 1
        ;;
    *)
        log_error "Unknown subcommand: $1"
        show_help
        exit 1
        ;;
esac
