#!/usr/bin/env bash
# ldx-help: infra Manage local Vault deployment

set -euo pipefail

# Locate the dev-rig checkout (LDX_HOME) from this command's real path.
_LDX_SELF="$(realpath "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${_LDX_SELF}")"
export LDX_HOME="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# Base version guard: the chart pins the Vault app version
# (0.34.1 -> Vault 2.0.4). Never silently pull a newer chart; ldx vault
# upgrade handles version moves deliberately (snapshot + checks).
VAULT_CHART_VERSION="0.34.1"

source "${LDX_HOME}/bin/lib/common.sh"

# Vault operator init JSON (unseal keys + root token) lives in the host
# secret store as ldx/vault/init_json. Legacy installs kept it in
# ${VAULT_DIR}/keys.json; the whole file is imported on first read (blob,
# not KEY=VALUE) and removed after verification.
vault_keys_json() {
    ldx_secret_get_blob vault "${VAULT_DIR}/keys.json" init_json
}

# Helm values file that defines this rig's Vault deployment. Shared by setup
# and upgrade so an upgrade never relies on --reuse-values: chart 0.34.x added
# new value sections (server.httproute) whose templates blow up when the old
# release's values are reused without the new chart's defaults.
# See config/vault-values.yaml for the full values and rationale.
VAULT_HELM_VALUES="${CONFIG_DIR}/vault-values.yaml"

show_help() {
    echo "Usage: $(basename "$0") <setup|status|unseal|seal|create-user|sso|upgrade|snapshot|uninstall> [options]"
    echo ""
    echo "Commands:"
    echo "  setup       Install Vault, initialize it, and store keys."
    echo "  status      Show the current status of the Vault installation."
    echo "  unseal      Unseal the Vault using stored keys."
    echo "  seal        Seal the Vault."
    echo "  create-user Create (or update) a userpass user with entity metadata."
    echo "  enable-secrets  Enable the KV v2 secrets engine and Kubernetes auth method."
    echo "  sso         Configure Vault to use Authelia as its OIDC provider (Touch ID login)."
    echo "  upgrade     Upgrade Vault to a chart version (default: latest) with a snapshot + checks."
    echo "  snapshot    Save a storage snapshot (Raft or file backend; Vault must be unsealed)."
    echo "  uninstall   Remove Vault and its stored keys."
    echo ""
    echo "Options for setup:"
    echo "  --oidc-client-id <id>          Google OIDC Client ID (enables OIDC login with WebAuthn/Passkeys)"
    echo "  --oidc-client-secret <secret>  Google OIDC Client Secret"
    echo "  --disable-userpass             Disable the default 'admin' userpass login (useful if relying purely on OIDC)"
    echo ""
    echo "Options for create-user:"
    echo "  --password <pass>      Password (prompted when omitted)"
    echo "  --full-name <name>     Display name exposed to OIDC clients via the profile scope"
    echo "  --email <email>        Email exposed to OIDC clients via the profile scope"
    echo "  --policies <list>      Vault policies for the user (default: default)"
    echo ""
    echo "Options for enable-secrets:"
    echo "  (none required; enables KV v2 at 'secret', Kubernetes auth, and the mcp-secrets-read policy)"
    echo ""
    echo "Options for sso:"
    echo "  (none required; requires 'ldx authelia install' to have been run first)"
    echo ""
    echo "Options for upgrade:"
    echo "  <chart-version>        Target chart version (e.g. 0.34.1, app Vault 2.0.4)."
    echo "                         Omit to upgrade to the latest chart."
    echo "  --dry-run              Show what would change; do not touch the cluster."
    echo ""
    echo "Alternatively, you can set OIDC_CLIENT_ID and OIDC_CLIENT_SECRET environment variables."
}

status_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace
    namespace="$(ldx_namespace vault)"

    # Check if pod exists
    local phase
    phase=$(kubectl get pods vault-0 -n "$namespace" -o 'jsonpath={..status.phase}' 2>/dev/null) || true

    if [ -z "$phase" ]; then
        log_info "Vault is not installed. Run 'setup' to install it."
        return
    fi

    if [ "$phase" != "Running" ]; then
        log_warn "Vault pod is in '$phase' state (not Running)."
        return
    fi

    # Pod is running, check sealed status
    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true

    if [ "$sealed" = "true" ]; then
        log_warn "Vault is running but sealed. Run 'unseal' to unseal it."
    elif [ "$sealed" = "false" ]; then
        log_info "Vault is running and unsealed."
    else
        log_warn "Vault pod is Running but could not determine seal status."
    fi

    log_info "Access URL: https://vault.rd.localhost"
    log_info "In-cluster URL: http://vault.${namespace}.svc.cluster.local:8200"
}

# helm --wait names only the resource it gave up on. Say which pods are stuck and
# quote what the scheduler complained about, so a failed rollout needs no follow-up
# kubectl to understand. Informational: exit status stays with the caller.
report_unready_pods() {
    local namespace="$1"

    kubectl get pods -n "$namespace" --no-headers 2>/dev/null |
        awk '{split($2, r, "/"); if (r[1] + 0 < r[2] + 0) printf "  %s  %s (%s)\n", $1, $3, $2}' |
        { grep . || echo "  (nothing reports not-ready; check 'helm history' for a stale failure)"; }

    kubectl get events -n "$namespace" --sort-by=.lastTimestamp 2>/dev/null |
        awk '$1 == "Warning"' | tail -n 5 | sed 's/^/  /'
}

# Finds the Traefik Service ClusterIP so we can configure hostAliases in the
# Vault pod. This allows Vault to reach Authelia through Traefik (so the Host
# header matches the OIDC issuer) without relying on external DNS.
get_traefik_cluster_ip() {
    local traefik_ns="" traefik_svc="" ip=""

    # Try common namespaces where Traefik might be deployed
    for ns in kube-system traefik ingress; do
        traefik_svc=$(kubectl get svc -n "$ns" -l app.kubernetes.io/name=traefik -o 'jsonpath={.items[0].metadata.name}' 2>/dev/null) || true
        if [ -n "$traefik_svc" ]; then
            traefik_ns="$ns"
            break
        fi
    done

    # If not found by label, try by name
    if [ -z "$traefik_svc" ]; then
        for ns in kube-system traefik ingress; do
            if kubectl get svc -n "$ns" traefik 2>/dev/null >/dev/null; then
                traefik_ns="$ns"
                traefik_svc="traefik"
                break
            fi
        done
    fi

    if [ -n "$traefik_ns" ] && [ -n "$traefik_svc" ]; then
        ip=$(kubectl get svc -n "$traefik_ns" "$traefik_svc" -o 'jsonpath={.spec.clusterIP}' 2>/dev/null) || true
    fi

    if [ -z "$ip" ] || [ "$ip" = "None" ]; then
        # Last resort: look for any Service with Type=LoadBalancer or the default TLS secret
        ip=$(kubectl get svc -A -o json 2>/dev/null | jq -r '.items[] | select(.spec.clusterIP != "None") | select(.metadata.name == "traefik" or .metadata.labels."app.kubernetes.io/name" == "traefik") | .spec.clusterIP' 2>/dev/null | head -1) || true
    fi

    printf '%s' "$ip"
}

setup_vault() {
    require_command "helm"
    require_command "kubectl"

    local namespace
    namespace="$(ldx_namespace k8s)"
    ldx_save_namespace vault "$namespace"

    # Cache the version before installing so it survives even if init is interrupted.
    record_vault_version "$VAULT_CHART_VERSION" "$(vault_app_version_for_chart "$VAULT_CHART_VERSION")"

    # Deployment lives in the ldx-local-platform chart (release 'ldx', service
    # 'vault'): the chart is pinned there, values and the Traefik hostAlias are
    # supplied by 'ldx k8s', and a sealed vault is auto-unsealed afterwards.
    # Everything below is the one-time imperative initialization.
    "${LDX_HOME}/bin/ldx" k8s up --services vault

    log_info "Waiting for Vault pod to be created and running..."
    while [[ $(kubectl get pods vault-0 -n "$namespace" -o 'jsonpath={..status.phase}' 2>/dev/null) != "Running" ]]; do
        echo -n "."
        sleep 2
    done
    echo ""

    sleep 5

    log_info "Initializing Vault..."
    if ldx_secret_has vault init_json || [ -f "${VAULT_DIR}/keys.json" ]; then
        log_warn "Vault keys already exist (ldx/vault/init_json). Skipping initialization."
        log_info "If you need to re-initialize, delete the stored secret first (backend: $(ldx_secret_backend))."
    else
        init_dirs
        local init_json
        init_json=$(kubectl exec -n "$namespace" vault-0 -- vault operator init -format=json)
        ldx_secret_put vault init_json "$init_json"
        log_info "Vault initialized. Unseal keys and root token stored in $(ldx_secret_backend) storage (ldx/vault/init_json)"
    fi

    unseal_vault

    configure_default_user

    enable_secrets_vault

    log_info "Vault UI and API are accessible at: https://vault.rd.localhost"
    if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
        log_info "You can login with Username: admin, Password: changeit"
    fi
    if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
        log_info "OIDC authentication is enabled. You can log in via your Identity Provider (e.g. Google)."
    fi
}

unseal_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace
    namespace="$(ldx_namespace vault)"

    local keys_json
    keys_json=$(vault_keys_json 2>/dev/null) \
        || fatal "Vault keys not found (ldx/vault/init_json). Run 'setup' first."

    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true
    if [ "$sealed" = "false" ]; then
        log_info "Vault is already unsealed."
        return
    fi

    log_info "Unsealing Vault..."

    jq -r .unseal_keys_b64[] <<<"$keys_json" | while read -r key; do
        kubectl exec -n "$namespace" vault-0 -- vault operator unseal "$key"
    done

    log_info "Vault unseal process complete."
}

configure_default_user() {
    require_command "kubectl"
    require_command "jq"

    local namespace
    namespace="$(ldx_namespace vault)"
    log_info "Configuring admin user and authentication methods..."

    local keys_json root_token
    keys_json=$(vault_keys_json 2>/dev/null) || {
        log_warn "Root token not found. Skipping user configuration."
        return
    }
    root_token=$(jq -r .root_token <<<"$keys_json")

    # We use a temporary shell script executed inside the pod to keep things clean
    cat <<EOF | kubectl exec -i -n "$namespace" vault-0 -- sh
        export VAULT_TOKEN="${root_token}"

        # Create an admin policy that has full permissions
        vault policy write admin - <<POLICY
path "*" {
  capabilities = ["create", "read", "update", "delete", "list", "sudo"]
}
POLICY

        # Always configure userpass unless DISABLE_USERPASS is true
        if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
            if ! vault auth list | grep -q "userpass/"; then
                vault auth enable userpass
            fi
            # Create or update the admin user with the password 'changeit' and assign the admin policy
            vault write auth/userpass/users/admin password=changeit policies=admin

            # Give the admin entity profile metadata (full_name/email) so OIDC
            # providers that request the profile scope can render claims for
            # it. The login materializes the entity and its userpass alias;
            # VAULT_TOKEN must be unset for the login response to carry the
            # auth block, and the image has no jq, so parse with sed.
            unset VAULT_TOKEN
            admin_entity_id=\$(vault login -format=json -method=userpass username=admin password=changeit 2>/dev/null | sed -n 's/.*"entity_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
            export VAULT_TOKEN="${root_token}"
            # No "id" in the body: the path already carries it, and Vault warns when a
            # body repeats a parameter it takes from the URL.
            if [ -n "\$admin_entity_id" ]; then
                printf '{"name":"admin","metadata":{"full_name":"Administrator","email":"admin@rd.localhost"}}' | vault write identity/entity/id/\$admin_entity_id - >/dev/null
            fi

            # Shared OIDC profile scope: OIDC clients (e.g. agentgateway)
            # request scope=profile and Vault renders name/email from entity
            # metadata set above (or by 'create-user'). Missing metadata
            # renders as an empty claim, never an error.
            vault write identity/oidc/scope/profile \
                description="Profile information (name, email)" \
                template='{"name": {{identity.entity.metadata.full_name}}, "email": {{identity.entity.metadata.email}}}' >/dev/null
        else
            # If someone explicitly disables it later, we could optionally disable the auth path,
            # but for a dev script, it's safer to just skip creating/updating it.
            if vault auth list | grep -q "userpass/"; then
                vault auth disable userpass || true
            fi
        fi

        # Configure OIDC if credentials are provided
        if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
            if ! vault auth list | grep -q "oidc/"; then
                vault auth enable oidc
            fi

            vault write auth/oidc/config \\
                oidc_discovery_url="https://accounts.google.com" \\
                oidc_client_id="${OIDC_CLIENT_ID:-}" \\
                oidc_client_secret="${OIDC_CLIENT_SECRET:-}" \\
                default_role="admin"

            vault write auth/oidc/role/admin \\
                bound_audiences="${OIDC_CLIENT_ID:-}" \\
                allowed_redirect_uris="https://vault.rd.localhost/ui/vault/auth/oidc/oidc/callback" \\
                allowed_redirect_uris="http://localhost:8250/oidc/callback" \\
                user_claim="sub" \\
                policies="admin"
        fi
EOF

    local auth_methods=""
    if [ "${DISABLE_USERPASS:-false}" != "true" ]; then
        auth_methods="Username/Password"
    fi
    if [ -n "${OIDC_CLIENT_ID:-}" ] && [ -n "${OIDC_CLIENT_SECRET:-}" ]; then
        if [ -n "$auth_methods" ]; then
            auth_methods="$auth_methods and OIDC"
        else
            auth_methods="OIDC"
        fi
    fi

    log_info "Vault configured successfully with ${auth_methods:-No} authentication."
}

# --- Vault API access ---------------------------------------------------------
# Pods reach Vault at http://vault.<namespace>.svc; host-side CLI calls go
# through the Traefik ingress instead. The certificate for it comes from
# 'ldx tls setup', whose wildcard covers *.rd.localhost, so the Go binary
# verifies it without -k.
VAULT_API_URL="https://vault.rd.localhost"
VAULT_ROOT_TOKEN=""

# Address and token are passed explicitly, so an ambient VAULT_ADDR/VAULT_TOKEN
# in the caller's shell can never point these commands at another server.
vault_cli() {
    VAULT_ADDR="$VAULT_API_URL" VAULT_TOKEN="$VAULT_ROOT_TOKEN" vault "$@"
}

# Loads the cached root token and requires a reachable, unsealed Vault.
# Reads `.sealed` as a raw boolean: jq's `//` treats `false` as absent, so
# `.sealed // empty` would report a healthy Vault as unreachable.
# Retries for up to 60 seconds to handle the case where Traefik isn't ready yet
# (e.g., during 'setup' when the ingress is still being configured).
require_unsealed_vault() {
    local keys_json
    keys_json=$(vault_keys_json 2>/dev/null) \
        || fatal "Vault root token not found (ldx/vault/init_json). Run 'setup' first."
    VAULT_ROOT_TOKEN=$(jq -r .root_token <<<"$keys_json")

    local sealed="" attempts=0
    while [ $attempts -lt 12 ]; do
        sealed=$(vault_cli status -format=json 2>/dev/null | jq -r '.sealed') || true
        case "$sealed" in
            false) return ;;
            true) fatal "Vault is sealed. Run 'unseal' first." ;;
        esac
        attempts=$((attempts + 1))
        if [ $attempts -lt 12 ]; then
            echo -n "."
            sleep 5
        fi
    done
    echo ""
    fatal "Cannot reach Vault at ${VAULT_API_URL} after 60s. Is 'ldx tls install' done and the cluster up?"
}

create_user_vault() {
    require_command "jq"
    require_command "vault"

    local username="" password="" full_name="" email="" policies="default"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --password)
                password="$2"
                shift 2
                ;;
            --full-name)
                full_name="$2"
                shift 2
                ;;
            --email)
                email="$2"
                shift 2
                ;;
            --policies)
                policies="$2"
                shift 2
                ;;
            -*)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                if [ -z "$username" ]; then
                    username="$1"
                    shift
                else
                    log_error "Unexpected argument: $1"
                    show_help
                    exit 1
                fi
                ;;
        esac
    done

    if [ -z "$username" ]; then
        fatal "Usage: ldx vault create-user <username> [--password <pass>] [--full-name <name>] [--email <email>] [--policies <list>]"
    fi

    if [ -z "$password" ]; then
        # `|| true`: with no TTY (CI, a pipe) read hits EOF and fails, and set -e
        # would drop out here without a word. An empty password is meaningful below.
        read -rsp "Password for '${username}' (unchanged if left empty): " password || true
        echo ""
    fi

    require_unsealed_vault

    log_info "Creating user '${username}' in Vault..."

    # Ensure userpass auth is enabled.
    if ! vault_cli read -format=json sys/auth | jq -e '.data | has("userpass/")' >/dev/null 2>&1; then
        vault_cli auth enable userpass >/dev/null
    fi

    # Ensure the shared OIDC `profile` scope exists (canonical owner: 'setup';
    # this also repairs installs that predate it). Idempotent.
    vault_cli write identity/oidc/scope/profile \
        description="Profile information (name, email)" \
        template='{"name": {{identity.entity.metadata.full_name}}, "email": {{identity.entity.metadata.email}}}' >/dev/null

    # Create the user, or update it without touching the password when blank.
    if [ -n "$password" ]; then
        vault_cli write "auth/userpass/users/${username}" password="$password" policies="$policies" >/dev/null
    elif vault_cli read "auth/userpass/users/${username}" >/dev/null 2>&1; then
        vault_cli write "auth/userpass/users/${username}" policies="$policies" >/dev/null
    else
        fatal "user '${username}' does not exist and no --password was given."
    fi

    # A successful login both checks the password and makes Vault materialize the
    # entity and its userpass alias. -no-store keeps the caller's own token file.
    if [ -n "$password" ] &&
        ! vault_cli login -no-store -method=userpass username="$username" password="$password" >/dev/null 2>&1; then
        log_warn "Could not log in with the given password."
    fi

    local accessor entity_id
    accessor=$(vault_cli read -format=json sys/auth | jq -r '.data["userpass/"].accessor // empty')

    # Find the entity by its userpass alias. identity/lookup/entity is documented
    # as POST-only, but Vault answers the CLI's PUT as well, so the CLI covers
    # every identity call this command needs.
    entity_id=""
    if [ -n "$accessor" ]; then
        entity_id=$(vault_cli write -format=json -field=id identity/lookup/entity \
            alias_name="$username" alias_mount_accessor="$accessor" 2>/dev/null | tr -d '"') || true
    fi

    # Read-modify-write the entity so unrelated metadata keys survive (a PUT
    # replaces the whole map) and the entity name Vault assigned is kept.
    local entity_name="$username" current_meta='{}' metadata entity_json
    if [ -n "$entity_id" ]; then
        entity_json=$(vault_cli read -format=json "identity/entity/id/${entity_id}" 2>/dev/null) || true
        if [ -n "$entity_json" ]; then
            current_meta=$(jq -c '.data.metadata // {}' <<<"$entity_json")
            [ -n "$current_meta" ] || current_meta='{}'
            entity_name=$(jq -r '.data.name // empty' <<<"$entity_json")
            [ -n "$entity_name" ] || entity_name="$username"
        fi
    fi
    metadata=$(jq -cn \
        --argjson current "$current_meta" --arg full_name "$full_name" --arg email "$email" \
        '$current
         + (if $full_name == "" then {} else {full_name: $full_name} end)
         + (if $email == "" then {} else {email: $email} end)')

    if [ -n "$entity_id" ]; then
        # The id comes from the path, so it stays out of the body.
        jq -n --arg name "$entity_name" --argjson metadata "$metadata" \
            '{name: $name, metadata: $metadata}' \
            | vault_cli write "identity/entity/id/${entity_id}" - >/dev/null
    elif [ -n "$accessor" ] && [ "$metadata" != "{}" ]; then
        # Entity does not exist yet (user never logged in): create it with the
        # metadata and bind the userpass alias so the first login maps onto it.
        entity_id=$(jq -n --arg name "$username" --argjson metadata "$metadata" \
            '{name: $name, metadata: $metadata}' \
            | vault_cli write -format=json -field=id identity/entity - 2>/dev/null | tr -d '"') || true
        if [ -n "$entity_id" ]; then
            vault_cli write identity/entity-alias \
                name="$username" canonical_id="$entity_id" mount_accessor="$accessor" >/dev/null
        fi
    fi

    log_info "User '${username}' ready (policies: ${policies})."
    if [ -z "$entity_id" ]; then
        log_warn "No entity for '${username}' and nothing to store; metadata was left unchanged."
    elif [ -n "$full_name" ] || [ -n "$email" ]; then
        log_info "Entity: ${entity_id} (full_name: ${full_name:-unchanged}, email: ${email:-unchanged})"
        log_info "OIDC clients requesting the 'profile' scope will receive these as name/email claims."
    else
        log_info "Entity: ${entity_id}"
    fi
}

# --- Secrets engine and auth method setup -----------------------------------
# Enables the KV v2 secrets engine (path: secret), the Kubernetes auth method,
# and the mcp-secrets-read policy. Idempotent: safe to re-run. Called by
# 'enable-secrets' and by 'setup' for new installs.
enable_secrets_vault() {
    require_command "kubectl"
    require_command "jq"

    require_unsealed_vault

    local namespace
    namespace="$(ldx_namespace vault)"

    # --- Enable KV v2 secrets engine at 'secret' path ---
    # Check if it's already enabled (idempotent).
    if vault_cli secrets list -format=json 2>/dev/null | jq -e '.["secret/"]' >/dev/null 2>&1; then
        log_info "KV v2 secrets engine already enabled at 'secret'."
    else
        log_info "Enabling KV v2 secrets engine at 'secret'..."
        vault_cli secrets enable -path=secret -version=2 kv >/dev/null
        log_info "KV v2 secrets engine enabled at 'secret'."
    fi

    # --- Enable Kubernetes auth method ---
    # The Vault pod is in the cluster and can reach the API server at the
    # in-cluster DNS name. Skip TLS verification: Rancher Desktop uses a
    # self-signed cert that Vault does not trust.
    if vault_cli auth list -format=json 2>/dev/null | jq -e '.["kubernetes/"]' >/dev/null 2>&1; then
        log_info "Kubernetes auth method already enabled."
    else
        log_info "Enabling Kubernetes auth method..."
        vault_cli auth enable kubernetes >/dev/null
        vault_cli write auth/kubernetes/config \
            kubernetes_host="https://kubernetes.default.svc:443" \
            skip_tls_verify=true >/dev/null
        log_info "Kubernetes auth method enabled (host: https://kubernetes.default.svc:443)."
    fi

    # --- Create the mcp-secrets-read policy ---
    # Grants read/list on the MCP secrets subtree. This is the minimal policy
    # the Vault Agent sidecar needs to read MCP credentials.
    cat <<POLICY | vault_cli policy write mcp-secrets-read - >/dev/null
path "secret/data/mcp/*" {
  capabilities = ["read", "list"]
}
path "secret/metadata/mcp/*" {
  capabilities = ["read", "list"]
}
POLICY
    log_info "Policy 'mcp-secrets-read' created."

    log_info "Vault secrets engine and auth method setup complete."
    log_info "  - KV v2 at 'secret' (MCP credentials go to secret/data/mcp/<name>/token)"
    log_info "  - Kubernetes auth (Vault Agent sidecars authenticate with their SA JWT)"
    log_info "  - Policy 'mcp-secrets-read' (minimal read access for the Vault Agent)"
}

# --- Authelia SSO ---------------------------------------------------------------
# Configures Vault's OIDC auth method to point at Authelia (deployed by 'ldx
# authelia install'). After this, Vault logins redirect to Authelia, which
# presents Touch ID (WebAuthn) after the initial password+enrollment setup.
# Userpass stays enabled as a fallback.
AUTHELIA_SECRETS_DIR="${CACHE_DIR}/authelia"
AUTHELIA_SECRETS_FILE="${AUTHELIA_SECRETS_DIR}/client_secrets"
AUTHELIA_HOST="auth.rd.localhost"

sso_vault() {
    require_command "kubectl"
    require_command "jq"
    require_command "curl"

    # Read the Vault client secret from the Authelia cache (created by 'ldx authelia install')
    local vault_client_secret
    # Host secret store (Keychain); the pre-Keychain file (KEY=VALUE lines)
    # is imported on first read.
    vault_client_secret=$(ldx_secret_get_kv "authelia/client_secrets" "$AUTHELIA_SECRETS_FILE" VAULT_CLIENT_SECRET 2>/dev/null) || true
    if [ -z "$vault_client_secret" ]; then
        fatal "VAULT_CLIENT_SECRET not found in ${AUTHELIA_SECRETS_FILE}."
    fi

    # Check that Authelia is running and its OIDC discovery endpoint responds
    local authelia_namespace
    authelia_namespace="$(ldx_namespace authelia)"
    local phase
    phase=$(kubectl get pods -n "$authelia_namespace" -l app.kubernetes.io/name=authelia -o 'jsonpath={..status.phase}' 2>/dev/null) || phase="NotFound"
    if [ "$phase" != "Running" ]; then
        fatal "Authelia is not running (pod phase: ${phase}). Run 'ldx authelia install' first."
    fi

    local discovery_url="https://${AUTHELIA_HOST}/.well-known/openid-configuration"
    if ! curl -sf "${discovery_url}" > /dev/null 2>&1; then
        fatal "Cannot reach Authelia OIDC discovery at ${discovery_url}. Is Traefik configured with TLS?"
    fi

    require_unsealed_vault

    local namespace
    namespace="$(ldx_namespace vault)"

    log_info "Configuring Vault OIDC auth method to use Authelia..."

    local authelia_external_url="https://${AUTHELIA_HOST}"

    # Read the CA from the ClusterTrustBundle (created by 'ldx certmanager install').
    # The PEM content is safe to embed in the heredoc (only base64 chars and newlines).
    local ca_pem=""
    ca_pem=$(kubectl get clustertrustbundle mkcert-ca -o jsonpath='{.spec.trustBundle}' 2>/dev/null || true)
    if [ -n "$ca_pem" ]; then
        log_info "Using mkcert root CA from ClusterTrustBundle for TLS verification."
    else
        log_warn "ClusterTrustBundle 'mkcert-ca' not found or empty. Vault may fail to verify Authelia's TLS certificate."
        log_warn "Run 'ldx certmanager install' first."
    fi

    # Run the Vault API calls inside the pod (same pattern as configure_default_user).
    # The image has no jq, so we avoid relying on it.
    cat <<EOF | kubectl exec -i -n "$namespace" vault-0 -- sh
        export VAULT_TOKEN="${VAULT_ROOT_TOKEN}"

        # Enable OIDC auth method if not already enabled
        if ! vault auth list | grep -q "oidc/"; then
            vault auth enable oidc
        fi

        # Use the external URL (base URL, without the discovery path) for the discovery
        # endpoint. Vault appends /.well-known/openid-configuration automatically.
        # All other endpoints use the full URL.
        #
        # The Vault pod resolves auth.rd.localhost to Traefik's ClusterIP via CoreDNS
        # (glibc queries DNS for .localhost, unlike musl which follows RFC 6761 strictly).
        # This ensures the Host header matches the OIDC issuer (Authelia validates it),
        # and the request goes through Traefik for proper TLS termination.
        #
        # CA certificates are passed as PEM content using the correct parameter names:
        # oidc_discovery_ca_pem for the discovery URL and jwks_ca_pem for the JWKS URL.
        if [ -n "${ca_pem}" ]; then
            vault write auth/oidc/config \\
                oidc_discovery_url="${authelia_external_url}" \\
                oidc_discovery_ca_pem="${ca_pem}" \\
                oidc_authorization_url="${authelia_external_url}/api/oidc/authorization" \\
                oidc_token_url="${authelia_external_url}/api/oidc/token" \\
                oidc_jwks_url="${authelia_external_url}/.well-known/jwks.json" \\
                jwks_ca_pem="${ca_pem}" \\
                oidc_client_id="vault" \\
                oidc_client_secret="${vault_client_secret}" \\
                default_role="admin"
        else
            vault write auth/oidc/config \\
                oidc_discovery_url="${authelia_external_url}" \\
                oidc_authorization_url="${authelia_external_url}/api/oidc/authorization" \\
                oidc_token_url="${authelia_external_url}/api/oidc/token" \\
                oidc_jwks_url="${authelia_external_url}/.well-known/jwks.json" \\
                oidc_client_id="vault" \\
                oidc_client_secret="${vault_client_secret}" \\
                default_role="admin"
        fi

        # Create role for Authelia logins. The email claim from Authelia maps to
        # the Vault entity. The admin entity has email admin@rd.localhost (set by
        # 'setup'), which matches the Authelia admin user's email.
        #
        # oidc_scopes requests the email and profile scopes so Authelia includes
        # the email claim in the token (required by user_claim="email").
        vault write auth/oidc/role/admin \\
            bound_audiences="vault" \\
            allowed_redirect_uris="https://vault.rd.localhost/ui/vault/auth/oidc/oidc/callback" \\
            allowed_redirect_uris="http://localhost:8250/oidc/callback" \\
            user_claim="email" \\
            oidc_scopes="openid,email,profile" \\
            policies="admin"
EOF

    log_info "Vault OIDC login is now wired to Authelia."
    log_info "Open https://vault.rd.localhost and choose 'Authelia' (or 'OIDC') as the login method."
    log_info "After the first login, you will be prompted by Touch ID."
    log_info "Userpass (admin/changeit) remains available as a fallback."
}

# --- Version tracking ---------------------------------------------------------
# ${VAULT_DIR}/version.json records the chart/app version this workspace's
# setup pins and what the cluster actually runs, so later upgrades (or a
# downgrade) know the base. Written by setup and upgrade.
record_vault_version() {
    local chart="$1" app="$2" prev_chart="${3:-}" prev_app="${4:-}"
    init_dirs
    local file="${VAULT_DIR}/version.json" updated
    updated=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [ -f "$file" ] && jq -e . "$file" >/dev/null 2>&1; then
        [ -n "$prev_chart" ] || prev_chart=$(jq -r '.base_chart // empty' "$file")
        [ -n "$prev_app" ] || prev_app=$(jq -r '.base_app // empty' "$file")
    fi
    jq -n \
        --arg base_chart "$chart" --arg base_app "$app" \
        --arg chart "$chart" --arg app "$app" \
        --arg prev_chart "$prev_chart" --arg prev_app "$prev_app" \
        --arg updated "$updated" \
        '{base_chart: $base_chart, base_app: $base_app,
          chart: $chart, app: $app,
          previous_chart: (if $prev_chart == "" then null else $prev_chart end),
          previous_app: (if $prev_app == "" then null else $prev_app end),
          updated_at: $updated}' > "$file"
}

# Chart version of the installed helm release, e.g. "0.33.0" (empty if absent).
vault_release_chart() {
    helm list -n "$(ldx_namespace vault)" -o json 2>/dev/null \
        | jq -r '.[] | select(.name == "vault") | .chart' 2>/dev/null \
        | sed -n 's/^vault-//p'
}

# Status of the installed helm release ("deployed", "failed", ...).
vault_release_status() {
    helm list -n "$(ldx_namespace vault)" -o json 2>/dev/null \
        | jq -r '.[] | select(.name == "vault") | .status' 2>/dev/null
}

# Vault app version the running pod reports (empty if not running).
vault_live_app_version() {
    kubectl get pod vault-0 -n "$(ldx_namespace vault)" \
        -o jsonpath='{.spec.containers[?(@.name=="vault")].image}' 2>/dev/null \
        | sed -n 's/.*:\(.*\)$/\1/p'
}

# App version pinned by a given chart version (empty when unknown).
vault_app_version_for_chart() {
    helm show chart hashicorp/vault --version "$1" 2>/dev/null \
        | sed -n 's/^appVersion:[[:space:]]*//p' | tr -d '"' | head -1
}

# Storage backend declared in the generated Vault config: "raft" | "file".
vault_storage_type() {
    local type
    type=$(kubectl get configmap vault-config -n "$(ldx_namespace vault)" -o jsonpath='{.data.config}' 2>/dev/null \
        | sed -n 's/.*storage "\([a-z-]*\)".*/\1/p' | head -1)
    printf '%s' "${type:-file}"
}

snapshot_vault() {
    require_command "kubectl"
    require_command "jq"

    local namespace
    namespace="$(ldx_namespace vault)"
    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true
    [ "$sealed" = "false" ] || fatal "Vault is sealed (or not running). Run 'unseal' first."

    init_dirs
    local chart storage snap
    chart=$(vault_release_chart)
    storage=$(vault_storage_type)
    snap="${VAULT_DIR}/snapshots/$(date +%Y%m%d-%H%M%S)-vault${chart:+-${chart}}-${storage}.snap"

    case "$storage" in
        raft)
            log_info "Saving Raft snapshot..."
            kubectl exec -n "$namespace" vault-0 -- vault operator raft snapshot save /tmp/raft.snap >/dev/null
            kubectl cp "${namespace}/vault-0:/tmp/raft.snap" "$snap" >/dev/null
            kubectl exec -n "$namespace" vault-0 -- rm -f /tmp/raft.snap 2>/dev/null || true
            ;;
        file)
            # File backend (chart default for standalone): the data dir on the
            # PVC *is* the database. Tar it out of the pod. Writes during the
            # tar are rare on a dev box; for a hard-consistent copy seal first.
            log_info "Backing up file storage (/vault/data)..."
            kubectl exec -n "$namespace" vault-0 -- tar czf /tmp/filedb.tgz -C /vault data >/dev/null
            kubectl cp "${namespace}/vault-0:/tmp/filedb.tgz" "$snap" >/dev/null
            kubectl exec -n "$namespace" vault-0 -- rm -f /tmp/filedb.tgz 2>/dev/null || true
            ;;
        *)
            fatal "Unsupported storage backend '${storage}'. Snapshot manually."
            ;;
    esac

    if [ ! -s "$snap" ]; then
        rm -f "$snap"
        fatal "Snapshot is empty; the file was not written."
    fi
    log_info "Snapshot saved (${storage}): ${snap} ($(wc -c < "$snap" | tr -d ' ') bytes)"
}

upgrade_vault() {
    require_command "helm"
    require_command "kubectl"
    require_command "jq"

    # Guard: post-chart-workspace upgrades go through the umbrella chart.
    local k8s_ns
    k8s_ns="$(ldx_namespace k8s)"
    if helm status "ldx" -n "$k8s_ns" &>/dev/null &&
       helm get values "ldx" -n "$k8s_ns" -a -o json 2>/dev/null \
           | jq -e '.vaultStack.enabled == true' &>/dev/null; then
        fatal "Vault is managed by the ldx-local-platform chart (pinned in charts/ldx-local-platform/Chart.yaml). Upgrade flow: 'ldx vault snapshot', bump the vault dependency version in Chart.yaml, run 'helm dependency update .' in that chart, then 'ldx k8s up --services vault' and 'ldx vault status'."
    fi

    local namespace
    namespace="$(ldx_namespace vault)"
    local target="" dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run)
                dry_run=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                [ -z "$target" ] || { log_error "Unexpected argument: $1"; exit 1; }
                target="$1"
                shift
                ;;
        esac
    done

    helm repo add hashicorp https://helm.releases.hashicorp.com --force-update >/dev/null 2>&1 || true
    helm repo update hashicorp >/dev/null 2>&1 || helm repo update >/dev/null

    local current status
    current=$(vault_release_chart)
    status=$(vault_release_status)
    [ -n "$current" ] || fatal "Vault is not installed. Run 'setup' first."

    if [ -z "$target" ]; then
        target=$(helm search repo hashicorp/vault -l 2>/dev/null | awk 'NR==2 {print $2}')
        [ -n "$target" ] || fatal "Could not determine the latest chart version."
        log_info "No version given; latest chart is ${target} (Vault $(vault_app_version_for_chart "$target"))."
    fi

    # A release already at the target and healthy is a no-op. A release stuck
    # at the target but 'failed' (a prior interrupted upgrade) is re-driven.
    if [ "$target" = "$current" ] && [ "$status" = "deployed" ]; then
        log_info "Vault already at chart ${target}; nothing to do."
        record_vault_version "$target" "$(vault_live_app_version)"
        return
    fi

    local target_app current_app
    target_app=$(vault_app_version_for_chart "$target")
    current_app=$(vault_live_app_version)
    log_info "Upgrade plan: chart ${current} (Vault ${current_app:-unknown}) -> chart ${target} (Vault ${target_app:-unknown})"

    if $dry_run; then
        helm upgrade vault hashicorp/vault \
            --version "$target" \
            --namespace "$namespace" \
            --values "$VAULT_HELM_VALUES" \
            --dry-run=client >/dev/null
        log_info "--dry-run: manifest rendered successfully; no changes applied."
        return
    fi

    # Pre-flight: Vault must be healthy and unsealed, and we must hold a
    # snapshot. Vault refuses to start against storage written by a newer
    # version, so the snapshot (or the PVC contents) is the rollback path.
    local sealed
    sealed=$(kubectl exec -n "$namespace" vault-0 -- vault status -format=json 2>/dev/null | jq -r .sealed 2>/dev/null) || true
    [ "$sealed" = "false" ] || fatal "Vault is sealed (or not running). Run 'unseal' first."

    snapshot_vault
    local snap
    snap=$(ls -t "${VAULT_DIR}/snapshots/"*.snap | head -1)

    log_info "Upgrading Vault Helm release to chart ${target}..."
    # --force-conflicts: the injector controller re-writes the webhook caBundle
    # outside helm; helm 4's server-side apply otherwise refuses the field.
    # No --wait: this chart rolls out OnDelete and its readiness probe fails
    # while sealed, so helm can never observe the new pod ready on its own.
    if ! helm upgrade vault hashicorp/vault \
        --version "$target" \
        --namespace "$namespace" \
        --values "$VAULT_HELM_VALUES" \
        --force-conflicts; then
        log_error "helm upgrade failed. Pods that are not ready:"
        report_unready_pods "$namespace"
        fatal "Snapshot: ${snap}. Fix and re-run, or consult docs/vault.md."
    fi

    # Drive the OnDelete rollout ourselves: recreate the pod so it picks up the
    # new image, then unseal (a fresh pod starts sealed).
    if [ "$(vault_live_app_version)" != "${target_app:-$current_app}" ]; then
        log_info "Recreating vault-0 to load the new image..."
        kubectl delete pod vault-0 -n "$namespace" --wait=true
    fi
    log_info "Waiting for the vault container to start..."
    kubectl wait --for=condition=ContainersReady pod/vault-0 -n "$namespace" --timeout=180s \
        || log_warn "vault-0 not ContainersReady yet; attempting unseal anyway."

    log_info "Re-unsealing (new pod starts sealed)..."
    unseal_vault

    # Wait for readiness now that it is unsealed (readiness = `vault status`).
    if ! kubectl wait --for=condition=Ready pod/vault-0 -n "$namespace" --timeout=120s; then
        fatal "vault-0 did not become Ready after unseal. Snapshot for rollback: ${snap}. See docs/vault.md."
    fi

    # Post checks: app version and that the OIDC issuer config survived the
    # version move. The provider discovery endpoint needs no token, so a 200
    # proves the identity backend read the (persisted) OIDC configuration.
    local new_app ok=true
    new_app=$(vault_live_app_version)
    log_info "Running pod image tag: ${new_app:-unknown} (expected ${target_app:-unknown})"

    if kubectl exec -n "$namespace" vault-0 -- sh -c \
        'wget -qO- http://127.0.0.1:8200/v1/identity/oidc/provider/agentgateway/.well-known/openid-configuration 2>/dev/null || curl -s http://127.0.0.1:8200/v1/identity/oidc/provider/agentgateway/.well-known/openid-configuration' \
        | grep -q '"issuer"'; then
        log_info "OIDC issuer responds: identity data intact."
    else
        log_warn "OIDC issuer did not respond after upgrade."
        ok=false
    fi

    record_vault_version "$target" "${new_app:-$target_app}" "$current" "$current_app"

    if $ok; then
        log_info "Upgrade complete: chart ${target}, Vault ${new_app:-$target_app}."
        log_info "Log in at https://agentgateway.rd.localhost/ui and confirm SSO still works."
    else
        fatal "Upgrade applied but a smoke check failed. Snapshot for rollback: ${snap}. See docs/vault.md."
    fi
}

seal_vault() {
    require_command "kubectl"

    local namespace
    namespace="$(ldx_namespace vault)"
    log_info "Sealing Vault..."
    kubectl exec -n "$namespace" vault-0 -- vault operator seal
    log_info "Vault is now sealed."
}

uninstall_vault() {
    require_command "kubectl"

    # Deployment teardown via the platform release (removes the webhook
    # config and, with --purge-data, the PVC); keys are host-side.
    "${LDX_HOME}/bin/ldx" k8s down --services vault --purge-data

    log_info "Removing local Vault keys..."
    rm -rf "${VAULT_DIR}"
    ldx_secret_delete vault init_json

    log_info "Vault uninstall complete. The namespace was not deleted."
}

main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    local subcommand="$1"
    shift

    case "$subcommand" in
        setup)
            export DISABLE_USERPASS=false
            # Parse additional arguments for setup
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --oidc-client-id)
                        export OIDC_CLIENT_ID="$2"
                        shift 2
                        ;;
                    --oidc-client-secret)
                        export OIDC_CLIENT_SECRET="$2"
                        shift 2
                        ;;
                    --disable-userpass)
                        export DISABLE_USERPASS=true
                        shift 1
                        ;;
                    *)
                        log_error "Unknown option: $1"
                        show_help
                        exit 1
                        ;;
                esac
            done
            setup_vault
            ;;
        status)
            status_vault
            ;;
        unseal)
            unseal_vault
            ;;
        seal)
            seal_vault
            ;;
        create-user)
            create_user_vault "$@"
            ;;
        enable-secrets)
            enable_secrets_vault "$@"
            ;;
        sso)
            sso_vault "$@"
            ;;
        upgrade)
            upgrade_vault "$@"
            ;;
        snapshot)
            snapshot_vault
            ;;
        uninstall)
            uninstall_vault
            ;;
        *)
            log_error "Unknown subcommand: $subcommand"
            show_help
            exit 1
            ;;
    esac
}

main "$@"