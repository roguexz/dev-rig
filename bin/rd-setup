#!/usr/bin/env bash

set -euo pipefail

# Get the directory of the current script to find lib/ and subscripts
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

# Source common utilities
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    echo "Usage: $(basename "$0") <command> [subcommand]"
    echo ""
    echo "Available commands:"
    echo "  tls           Manage TLS certificates and Traefik configuration"
    echo "  certmanager   Install and configure cert-manager"
    echo "  otel          Deploy and configure OpenTelemetry LGTM stack"
    echo "  redis         Deploy Redis stack"
    echo "  vault         Manage local Vault deployment"
    echo ""
    echo "Run '$(basename "$0") <command> help' for more information on a specific command."
}

if [ $# -lt 1 ]; then
    show_help
    exit 1
fi

COMMAND="$1"
shift

# Check if the modular script exists
SCRIPT_PATH="${SCRIPT_DIR}/rd-setup-${COMMAND}"

if [ ! -x "${SCRIPT_PATH}" ]; then
    if [ -f "${SCRIPT_PATH}" ]; then
      log_warn "Script '${SCRIPT_PATH}' exists but is not executable. Run 'chmod +x ${SCRIPT_PATH}'."
      exit 1
    else
      log_error "Unknown command: ${COMMAND}"
      show_help
      exit 1
    fi
fi

# Dispatch to the specific script
exec "${SCRIPT_PATH}" "$@"
