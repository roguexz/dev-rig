<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.system.cvescan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/cvescan.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/cvescan/launchd_out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/cvescan/launchd_err.log</string>
    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
